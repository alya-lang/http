# Classic (Synchronous / Polled TCP) HTTP Server Benchmark Target
import "std/net" as net
import "../src/lib.alya" as http

function handle_index(ctx)
    return http::ctx_text(ctx, "Hello from Alya Classic HTTP!", 200)
end

function handle_json(ctx)
    return http::ctx_json(ctx, "{\"status\":\"ok\",\"engine\":\"classic-sync\",\"concurrency\":\"single-thread-blocking\"}", 200)
end

function main()
    let port = 8081
    let host = "127.0.0.1"

    let rt = http::router()
    http::router_get(rt, "/", handle_index)
    http::router_get(rt, "/json", handle_json)

    let s = http::server(port, host, rt)
    let sock = http::server_start(s, 512)
    if sock < 0
        say "Failed to start classic server on " + host + ":" + str(port)
        exit(1)
    end

    say "[CLASSIC-SERVER] Ready and listening on http://" + host + ":" + str(port)

    while s.running == 1
        let ctx = http::server_accept(s, 1000)
        if ctx is not null
            let m = http::server_process(s, ctx)
            if m.found == 1 and m.action is not null
                let act = m.action
                act(ctx)
            end
            http::server_send(s, ctx)
        end
    end
end

main()
