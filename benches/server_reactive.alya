# Reactive (Asynchronous / event + uv Multiplexed) HTTP Server Benchmark Target
import "event" as ev
import "../src/lib.alya" as http

function handle_index(ctx)
    return http::ctx_text(ctx, "Hello from Alya Reactive HTTP!", 200)
end

function handle_json(ctx)
    return http::ctx_json(ctx, "{\"status\":\"ok\",\"engine\":\"reactive-event-uv\",\"concurrency\":\"non-blocking-multiplexed\"}", 200)
end

function main()
    let port = 8082
    let host = "127.0.0.1"

    let l = ev::loop()
    let rt = http::router()
    http::router_get(rt, "/", handle_index)
    http::router_get(rt, "/json", handle_json)

    let s = http::server(port, host, rt)
    http::server_use_event_loop(s, l)

    say "[REACTIVE-SERVER] Ready and listening on http://" + host + ":" + str(port)

    ev::run(l)
end

main()
