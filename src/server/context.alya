# HTTP Context Helpers and Response Builders
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "../core/status.alya"
import "../core/headers.alya"
import "../core/cookies.alya"
import "../core/multipart.alya"
import "../core/sse.alya"
@cfg(feature = "json")
import "json" as json_pkg
@cfg(feature = "mustache")
import "mustache" as mustache_pkg

## Creates a new HttpContext instance
pub function ctx_new(req: HttpRequest, res: HttpResponse = null, client_sock: int = -1)
    return context_create(req, res, client_sock)
end

## Sets response status code and optional status text
pub function ctx_status(ctx: HttpContext, code: int, text: string = "")
    if ctx is null
        return ctx
    end
    let res: HttpResponse = ctx.res
    if res is null
        return ctx
    end
    res.status_code = code
    if text != ""
        res.status_text = text
    else
        res.status_text = http_status_text(code)
    end
    return ctx
end

## Sets a response header on the context
pub function ctx_header(ctx: HttpContext, key: string, val)
    if ctx is not null
        let res: HttpResponse = ctx.res
        if res is not null
            header_set(res.headers, key, val)
        end
    end
    return ctx
end

## Retrieves a request header by case-insensitive key
pub function ctx_get_header(ctx: HttpContext, key: string, default_val: string = "")
    if ctx is null
        return default_val
    end
    let req: HttpRequest = ctx.req
    if req is null
        return default_val
    end
    let hdrs = req.headers
    return header_get(hdrs, key, default_val)
end

## Sets a cookie to be sent with the response
pub function ctx_cookie(ctx: HttpContext, name: string, val, path: string = "/", max_age: int = -1, http_only: int = 0, secure: int = 0, same_site: string = "Lax")
    if ctx is not null
        let res: HttpResponse = ctx.res
        if res is not null
            let c = cookie_new(name, val, path, max_age, http_only, secure, same_site)
            let cks = res.cookies
            push(cks, c)
        end
    end
    return ctx
end

## Retrieves an incoming cookie value by name
pub function ctx_get_cookie(ctx: HttpContext, name: string, default_val: string = "")
    if ctx is null
        return default_val
    end
    let req: HttpRequest = ctx.req
    if req is null
        return default_val
    end
    let cks = req.cookies
    if cks is null
        return default_val
    end
    if has(cks, name)
        return cks[name]
    end
    return default_val
end

## Retrieves a matched route path parameter by name (e.g. :id)
pub function ctx_param(ctx: HttpContext, name: string, default_val: string = "")
    if ctx is null
        return default_val
    end
    let req: HttpRequest = ctx.req
    if req is null
        return default_val
    end
    let p = req.params
    if p is null
        return default_val
    end
    if has(p, name)
        return p[name]
    end
    return default_val
end

## Retrieves a matched route parameter parsed as integer
pub function ctx_param_int(ctx: HttpContext, name: string, default_val: int = 0)
    let p = ctx_param(ctx, name, "")
    if p == ""
        return default_val
    end
    return to_int(p)
end

## Retrieves a parsed query string parameter by key
pub function ctx_query(ctx: HttpContext, name: string, default_val: string = "")
    if ctx is null
        return default_val
    end
    let req: HttpRequest = ctx.req
    if req is null
        return default_val
    end
    let qp = req.query_params
    if qp is null
        return default_val
    end
    if has(qp, name)
        return qp[name]
    end
    return default_val
end

## Retrieves the raw incoming request body
pub function ctx_body(ctx: HttpContext)
    if ctx is null
        return ""
    end
    let req: HttpRequest = ctx.req
    if req is null
        return ""
    end
    return req.body
end

## Retrieves parsed multipart form data from the request, or null if not multipart
pub function ctx_multipart(ctx: HttpContext)
    if ctx is null or ctx.req is null
        return null
    end
    if has(ctx.data, "_multipart_parsed")
        return ctx.data["_multipart_parsed"]
    end

    let ct = ctx_get_header(ctx, "content-type", "")
    if index_of(lower(ct), "multipart/form-data") < 0
        return null
    end

    let boundary = multipart_extract_boundary(ct)
    if boundary == ""
        return null
    end

    let req: HttpRequest = ctx.req
    let mp = multipart_parse(req.body, boundary)
    ctx.data["_multipart_parsed"] = mp
    return mp
end

## Retrieves a form field value by name (checks multipart first, then query/params)
pub function ctx_form(ctx: HttpContext, name: string, default_val: string = "") -> string
    if ctx is null or name is null or name == ""
        return default_val
    end

    let mp: MultipartData = ctx_multipart(ctx)
    if mp is not null
        let fv = mp.get_field(name, "")
        if fv != ""
            return fv
        end
    end

    return ctx_query(ctx, name, default_val)
end

## Retrieves an uploaded file by form field name
pub function ctx_file(ctx: HttpContext, name: string)
    if ctx is null or name is null or name == ""
        return null
    end

    let mp: MultipartData = ctx_multipart(ctx)
    if mp is null
        return null
    end

    return mp.get_file(name)
end

## Retrieves all uploaded files, optionally filtered by field name
pub function ctx_files(ctx: HttpContext, name: string = "") -> array
    if ctx is null
        return []
    end

    let mp: MultipartData = ctx_multipart(ctx)
    if mp is null
        return []
    end

    if name == ""
        return mp.file_list
    end

    let result = []
    let i = 0
    while i < len(mp.file_list)
        let f: HttpUploadedFile = mp.file_list[i]
        if f.name == name
            push(result, f)
        end
        i += 1
    end
    return result
end

## Sends a plain text response
pub function ctx_text(ctx: HttpContext, text_content: string, status_code: int = 200)
    ctx_status(ctx, status_code)
    let res: HttpResponse = ctx.res
    header_set(res.headers, "Content-Type", "text/plain; charset=utf-8")
    res.body = text_content
    return ctx
end

## Sends a JSON response string
pub function ctx_json(ctx: HttpContext, json_content: string, status_code: int = 200)
    ctx_status(ctx, status_code)
    let res: HttpResponse = ctx.res
    header_set(res.headers, "Content-Type", "application/json; charset=utf-8")
    res.body = json_content
    return ctx
end

## Sends an HTML response
pub function ctx_html(ctx: HttpContext, html_content: string, status_code: int = 200)
    ctx_status(ctx, status_code)
    let res: HttpResponse = ctx.res
    header_set(res.headers, "Content-Type", "text/html; charset=utf-8")
    res.body = html_content
    return ctx
end

## Sends an HTTP redirect response
pub function ctx_redirect(ctx: HttpContext, target_url: string, status_code: int = 302)
    ctx_status(ctx, status_code)
    let res: HttpResponse = ctx.res
    header_set(res.headers, "Location", target_url)
    res.body = ""
    return ctx
end

## Sends a 404 Not Found response
pub function ctx_not_found(ctx: HttpContext, message: string = "Not Found")
    return ctx_text(ctx, message, 404)
end

## Sends a 400 Bad Request response
pub function ctx_bad_request(ctx: HttpContext, message: string = "Bad Request")
    return ctx_text(ctx, message, 400)
end

## Sends a 401 Unauthorized response
pub function ctx_unauthorized(ctx: HttpContext, message: string = "Unauthorized")
    return ctx_text(ctx, message, 401)
end

## Sends a 403 Forbidden response
pub function ctx_forbidden(ctx: HttpContext, message: string = "Forbidden")
    return ctx_text(ctx, message, 403)
end

## Aborts request pipeline processing
pub function ctx_abort(ctx: HttpContext)
    if ctx is not null
        ctx.aborted = 1
    end
    return ctx
end

## Struct method for HttpContext.multipart
pub function HttpContext.multipart(self: HttpContext)
    return ctx_multipart(self)
end

## Struct method for HttpContext.form
pub function HttpContext.form(self: HttpContext, name: string, default_val: string = "") -> string
    return ctx_form(self, name, default_val)
end

## Struct method for HttpContext.file
pub function HttpContext.file(self: HttpContext, name: string)
    return ctx_file(self, name)
end

## Struct method for HttpContext.files
pub function HttpContext.files(self: HttpContext, name: string = "") -> array
    return ctx_files(self, name)
end

## Initializes the HttpContext for Server-Sent Events (SSE).
## Sets status to 200, Content-Type to text/event-stream, and caching headers.
pub function ctx_sse_init(ctx: HttpContext) -> HttpContext
    if ctx is null
        return ctx
    end
    ctx_status(ctx, 200)
    let res: HttpResponse = ctx.res
    header_set(res.headers, "Content-Type", "text/event-stream; charset=utf-8")
    header_set(res.headers, "Cache-Control", "no-cache")
    header_set(res.headers, "Connection", "keep-alive")
    if !has(ctx.data, "_sse_initialized")
        ctx.data["_sse_initialized"] = 1
    end
    return ctx
end

## Sends an SSE event through the HttpContext.
pub function ctx_sse_send(ctx: HttpContext, data: string, event_name: string = "", id: string = "", retry: int = -1, comment: string = "") -> HttpContext
    if ctx is null
        return ctx
    end
    if !has(ctx.data, "_sse_initialized")
        ctx_sse_init(ctx)
    end
    let ev = sse_event_create(data, event_name, id, retry, comment)
    let wire = sse_event_format(ev)
    let res: HttpResponse = ctx.res
    if res.body is null or res.body == ""
        res.body = wire
    else
        res.body += wire
    end
    return ctx
end

## Convenience helper to send an SSE message on the HttpContext.
pub function ctx_sse(ctx: HttpContext, data: string, event_name: string = "", id: string = "") -> HttpContext
    return ctx_sse_send(ctx, data, event_name, id)
end

## Convenience helper to send an SseEvent instance on the HttpContext.
pub function ctx_sse_event(ctx: HttpContext, event: SseEvent) -> HttpContext
    if ctx is null or event is null
        return ctx
    end
    return ctx_sse_send(ctx, event.data, event.event, event.id, event.retry, event.comment)
end

## Convenience helper to send an SSE comment/keep-alive ping on the HttpContext.
pub function ctx_sse_comment(ctx: HttpContext, comment: string) -> HttpContext
    return ctx_sse_send(ctx, "", "", "", -1, comment)
end

## Initializes the HttpContext for chunked transfer encoding.
pub function ctx_chunk_init(ctx: HttpContext, content_type: string = "application/octet-stream") -> HttpContext
    if ctx is null
        return ctx
    end
    ctx_status(ctx, 200)
    let res: HttpResponse = ctx.res
    header_set(res.headers, "Content-Type", content_type)
    header_set(res.headers, "Transfer-Encoding", "chunked")
    res.headers = header_remove(res.headers, "Content-Length")
    if !has(ctx.data, "_chunked_initialized")
        ctx.data["_chunked_initialized"] = 1
    end
    return ctx
end

## Appends a chunk to the response body using HTTP/1.1 chunked encoding.
pub function ctx_chunk_send(ctx: HttpContext, chunk_data: string) -> HttpContext
    if ctx is null
        return ctx
    end
    if !has(ctx.data, "_chunked_initialized")
        ctx_chunk_init(ctx)
    end
    let encoded = http_chunk_encode(chunk_data)
    let res: HttpResponse = ctx.res
    if res.body is null or res.body == ""
        res.body = encoded
    else
        res.body += encoded
    end
    return ctx
end

## Finalizes the chunked transfer encoding response by writing the terminating chunk.
pub function ctx_chunk_end(ctx: HttpContext) -> HttpContext
    if ctx is null
        return ctx
    end
    let res: HttpResponse = ctx.res
    let end_chunk = http_chunk_end()
    if res.body is null or res.body == ""
        res.body = end_chunk
    else
        res.body += end_chunk
    end
    return ctx
end

## Convenience helper for chunked transfer response chunk.
pub function ctx_chunk(ctx: HttpContext, chunk_data: string) -> HttpContext
    return ctx_chunk_send(ctx, chunk_data)
end

## Struct method for HttpContext.sse
pub function HttpContext.sse(self: HttpContext, data: string, event_name: string = "", id: string = "") -> HttpContext
    return ctx_sse(self, data, event_name, id)
end

## Struct method for HttpContext.send_event
pub function HttpContext.send_event(self: HttpContext, event: SseEvent) -> HttpContext
    return ctx_sse_event(self, event)
end

## Struct method for HttpContext.sse_comment
pub function HttpContext.sse_comment(self: HttpContext, comment: string) -> HttpContext
    return ctx_sse_comment(self, comment)
end

## Struct method for HttpContext.chunk
pub function HttpContext.chunk(self: HttpContext, chunk_data: string) -> HttpContext
    return ctx_chunk_send(self, chunk_data)
end

## Struct method for HttpContext.chunk_end
pub function HttpContext.chunk_end(self: HttpContext) -> HttpContext
    return ctx_chunk_end(self)
end

## Sends a JSON response built from a flat string map.
## Every value is JSON-quoted and escaped; convert numbers with `str(n)`
## before inserting when a numeric literal is required. For arbitrary
## nested values prefer `ctx_json_value`.
##
## Requires the `json` feature (default-on).
@cfg(feature = "json")
pub function ctx_json_map(ctx: HttpContext, m, status_code: int = 200)
    if ctx is null
        return ctx
    end
    let body = "{"
    let first = true
    for key, val in m
        if first == false
            body += ", "
        else
            first = false
        end
        body += "\"" + json_pkg::json_escape(key) + "\": \"" + json_pkg::json_escape(val) + "\""
    end
    body += "}"
    return ctx_json(ctx, body, status_code)
end

## Sends a JSON response serialized from any native value (maps and
## arrays nest recursively, strings are quoted and escaped).
## Booleans share the int encoding and render as `1`/`0`.
##
## Requires the `json` feature (default-on).
@cfg(feature = "json")
pub function ctx_json_value(ctx: HttpContext, val, status_code: int = 200)
    if ctx is null
        return ctx
    end
    return ctx_json(ctx, json_pkg::stringify(val), status_code)
end

## Parses the request body as JSON into native Alya types.
## Returns null for empty or invalid bodies (never throws).
##
## Requires the `json` feature (default-on).
@cfg(feature = "json")
pub function ctx_body_json(ctx: HttpContext)
    if ctx is null or ctx.req is null
        return null
    end
    let raw = ctx.req.body
    if raw is null or raw == ""
        return null
    end
    if json_pkg::is_valid(raw) == false
        return null
    end
    try
        return json_pkg::parse(raw)
    catch err
        return null
    end
end

## Renders a Mustache template string against `data` and sends it as HTML.
##
## Requires the `mustache` feature (default-on).
@cfg(feature = "mustache")
pub function ctx_render(ctx: HttpContext, template_str: string, data, status_code: int = 200)
    if ctx is null
        return ctx
    end
    return ctx_html(ctx, mustache_pkg::render(template_str, data), status_code)
end

## Renders a Mustache template file against `data` and sends it as HTML.
##
## Requires the `mustache` feature (default-on).
@cfg(feature = "mustache")
pub function ctx_render_file(ctx: HttpContext, file_path: string, data, status_code: int = 200)
    if ctx is null
        return ctx
    end
    return ctx_html(ctx, mustache_pkg::render_file(file_path, data), status_code)
end

## Retrieves the effective client IP, preferring `X-Forwarded-For` (first
## entry) then `X-Real-IP` before falling back to the socket remote address.
## Only trust proxy headers behind known proxies (see `server_enable_forwarded`).
pub function ctx_client_ip(ctx: HttpContext) -> string
    if ctx is null or ctx.req is null
        return ""
    end
    let xff = header_get(ctx.req.headers, "x-forwarded-for", "")
    if xff != ""
        let comma = _ctx_find_char(xff, ",")
        if comma >= 0
            return trim(substring(xff, 0, comma))
        end
        return trim(xff)
    end
    let real_ip = header_get(ctx.req.headers, "x-real-ip", "")
    if real_ip != ""
        return trim(real_ip)
    end
    return ctx.req.remote_addr
end

## Returns the effective request scheme: `X-Forwarded-Proto` when present,
## otherwise `https` for TLS contexts and `http`.
pub function ctx_scheme(ctx: HttpContext) -> string
    if ctx is not null and ctx.req is not null
        let proto = lower(header_get(ctx.req.headers, "x-forwarded-proto", ""))
        if proto == "https" or proto == "http"
            return proto
        end
    end
    if ctx is not null and ctx.data is not null and ctx.data["tls_enabled"] == true
        return "https"
    end
    return "http"
end

# Finds the first occurrence of a single character, or -1.
function _ctx_find_char(s: string, ch: string) -> int
    let i = 0
    while i < len(s)
        if substring(s, i, 1) == ch
            return i
        end
        i += 1
    end
    return -1
end
