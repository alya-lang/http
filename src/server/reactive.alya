## Reactive Event-Driven HTTP Server Adapter.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "event" as ev
import "../types.alya"
import "../core/protocol.alya"
import "../core/headers.alya"
import "../router/router.alya"
import "../middleware/logger.alya"
import "../middleware/compress.alya"
import "../websocket/handshake.alya"
import "../websocket/connection.alya"
import "./context.alya"
import "./server.alya"

## Internal writer callback for WebSocket over event::TcpStream.
pub function _reactive_ws_write(s: TcpStream, data)
    return ev::tcp_stream_write(s, data)
end

## Internal closer callback for WebSocket over event::TcpStream.
pub function _reactive_ws_close(s: TcpStream)
    return ev::tcp_stream_close(s)
end

## Creates a WebSocket connection over an event::TcpStream.
pub function ws_connection_from_stream(stream: TcpStream, is_server = 1) -> WebSocketConnection
    return ws_connection_new(stream, is_server, _reactive_ws_write, _reactive_ws_close)
end

## Represents the per-connection state of a reactive HTTP/WebSocket client.
##
## ### Fields
## - `stream`: Connection stream handle.
## - `server`: Owning server handle.
## - `buffer`: Accumulated byte buffer value.
## - `headers_parsed`: `1` once headers are complete, `0` otherwise.
## - `req`: Partial request value.
## - `content_length`: Declared body length integer.
## - `is_websocket`: `1` for upgraded connections, `0` otherwise.
## - `ws_conn`: WebSocket connection handle (or null).
## - `on_request_cb`: Request callback (or null).
## - `on_websocket_cb`: Upgrade callback (or null).
pub struct ReactiveClientState
    stream
    server
    buffer: string
    headers_parsed: int
    req
    content_length: int
    is_websocket: int
    ws_conn
    on_request_cb
    on_websocket_cb
end

## Callback invoked when a reactive client stream is closed.
pub function _on_reactive_client_close(_client_stream: TcpStream)
    # Stream cleanup is managed automatically by event::TcpStream
    return 0
end

## Callback invoked when data arrives on a reactive client stream.
pub function _on_reactive_client_data(client_stream: TcpStream, chunk: string)
    if client_stream is null or chunk is null or len(chunk) == 0
        return 0
    end
    let state: ReactiveClientState = client_stream.data
    if state is null
        return 0
    end

    # 1. If connection was already upgraded to WebSocket, forward raw chunk to driver
    if state.is_websocket == 1
        if state.ws_conn is not null
            let ws_conn: WebSocketConnection = state.ws_conn
            ws_feed(ws_conn, chunk)
        end
        return 1
    end

    # 2. Accumulate incoming bytes for HTTP request framing
    state.buffer = state.buffer + chunk

    while 1
        # 3. Header parsing phase
        if state.headers_parsed == 0
            let delim_idx = _proto_find(state.buffer, "\r\n\r\n", 0)
            let delim_len = 4
            if delim_idx < 0
                delim_idx = _proto_find(state.buffer, "\n\n", 0)
                delim_len = 2
            end

            if delim_idx >= 0
                let header_str = substring(state.buffer, 0, delim_idx)
                let remainder = ""
                let rem_start = delim_idx + delim_len
                if rem_start < len(state.buffer)
                    remainder = substring(state.buffer, rem_start, len(state.buffer) - rem_start)
                end
                state.buffer = remainder
                state.headers_parsed = 1

                let remote_addr = client_stream.peer_addr
                let req = http_parse_request(header_str + "\r\n\r\n", remote_addr)
                state.req = req

                # --- Check for WebSocket Upgrade ---
                if ws_is_upgrade_request(req) == 1
                    let accept_resp = ws_handshake_response(req)
                    ev::tcp_stream_write(client_stream, accept_resp)

                    let ws: WebSocketConnection = ws_connection_from_stream(client_stream, 1)

                    state.is_websocket = 1
                    state.ws_conn = ws

                    # Dispatch WebSocket handler
                    let ws_handled = 0
                    let m = router_match(state.server.router, req.method, req.path)
                    if m.found == 1 and m.action is not null
                        let act = m.action
                        act(ws, req)
                        ws_handled = 1
                    end

                    if ws_handled == 0 and state.on_websocket_cb is not null
                        let ws_cb = state.on_websocket_cb
                        ws_cb(ws, req)
                    end

                    # If remainder buffer already has frames, feed them into WebSocket
                    if len(state.buffer) > 0
                        ws_feed(ws, state.buffer)
                        state.buffer = ""
                    end
                    return 1
                end

                # --- Standard HTTP Content-Length check ---
                let cl_val = header_get(req.headers, "content-length", "0")
                state.content_length = to_int(cl_val)
            else
                break
            end
        end

        # 4. Body parsing phase
        if state.headers_parsed == 1
            let req_cl = state.content_length
            if len(state.buffer) >= req_cl
                let body_data = ""
                if req_cl > 0
                    body_data = substring(state.buffer, 0, req_cl)
                    if len(state.buffer) > req_cl
                        state.buffer = substring(state.buffer, req_cl, len(state.buffer) - req_cl)
                    else
                        state.buffer = ""
                    end
                end
                let req: HttpRequest = state.req
                req.body = body_data
                state.req = req

                let res = response_create(200, "OK")
                let ctx = context_create(req, res, client_stream.fd)

                # Apply server middlewares and router matching
                let m = server_process(state.server, ctx)

                # Dispatch route action or global request callback
                if m.found == 1 and m.action is not null
                    let act = m.action
                    act(ctx)
                elif state.on_request_cb is not null
                    let req_cb = state.on_request_cb
                    req_cb(ctx)
                end

                # Apply compression if enabled
                if state.server.options["compression_enabled"] == 1
                    mw_apply_compression(ctx, state.server.options["compression_config"])
                end

                # Log request if logger is enabled
                if state.server.options["logger_enabled"] == 1
                    mw_log_context(ctx)
                end

                # Connection persistence handling (Keep-Alive vs Close)
                let conn_hdr = lower(header_get(state.req.headers, "connection", ""))
                if conn_hdr == "close"
                    header_set(ctx.res.headers, "Connection", "close")
                else
                    header_set(ctx.res.headers, "Connection", "keep-alive")
                end

                # Serialize and write HTTP response non-blockingly
                let wire = http_format_response(ctx.res)
                ev::tcp_stream_write(client_stream, wire)

                if conn_hdr == "close"
                    ev::tcp_stream_close(client_stream)
                    break
                else
                    # Reset state for keep-alive HTTP pipeline
                    state.headers_parsed = 0
                    state.req = null
                    state.content_length = 0
                end
            else
                break
            end
        end
    end

    return 1
end

## Callback invoked when a new client connects to the reactive server.
pub function _on_reactive_client_connect(tcp_srv: TcpServer, client_stream: TcpStream)
    let srv = tcp_srv.data
    if srv is null
        return 0
    end

    let client_state = ReactiveClientState {
        stream: client_stream,
        server: srv,
        buffer: "",
        headers_parsed: 0,
        req: null,
        content_length: 0,
        is_websocket: 0,
        ws_conn: null,
        on_request_cb: srv.options["reactive_on_request"],
        on_websocket_cb: srv.options["reactive_on_websocket"]
    }

    client_stream.data = client_state
    client_stream.on_data_cb = _on_reactive_client_data
    client_stream.on_close_cb = _on_reactive_client_close
    return 1
end

## Callback invoked when a server-level socket error occurs.
pub function _on_reactive_server_error(_tcp_srv: TcpServer, _err_msg)
    return 0
end

# ═══════════════════════════════════════════════════════════════
# Public Reactive Server Adapter API
# ═══════════════════════════════════════════════════════════════

## Binds the HttpServer to an EventLoop, enabling reactive non-blocking I/O.
pub function server_use_event_loop(srv: HttpServer, loop: EventLoop, on_request = null, on_websocket = null)
    if srv is null or loop is null
        return null
    end

    srv.options["reactive_on_request"] = on_request
    srv.options["reactive_on_websocket"] = on_websocket

    let tcp_srv: TcpServer = ev::server(loop, srv.host, srv.port, _on_reactive_client_connect, _on_reactive_server_error, 128)
    if tcp_srv is null
        return null
    end

    tcp_srv.data = srv
    srv.loop = loop
    srv.tcp_server = tcp_srv
    srv.server_sock = tcp_srv.fd
    srv.running = 1

    return srv
end

## Shorthand factory for starting a reactive HTTP server.
pub function server_listen_reactive(srv: HttpServer, loop: EventLoop, on_request = null, on_websocket = null)
    return server_use_event_loop(srv, loop, on_request, on_websocket)
end

## Closes the reactive HTTP server and stops accepting connections.
pub function server_close_reactive(srv: HttpServer)
    if srv is null
        return 0
    end
    if srv.tcp_server is not null
        ev::tcp_server_close(srv.tcp_server)
        srv.tcp_server = null
    end
    srv.running = 0
    srv.server_sock = -1
    return 1
end

## Struct method for HttpServer.use_event_loop.
pub function HttpServer.use_event_loop(self: HttpServer, loop, on_request = null, on_websocket = null)
    return server_use_event_loop(self, loop, on_request, on_websocket)
end

## Struct method for HttpServer.close_reactive.
pub function HttpServer.close_reactive(self: HttpServer)
    return server_close_reactive(self)
end
