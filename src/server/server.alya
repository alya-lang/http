# HTTP Server Implementation
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/net" as net
import "tls" as tls
import "crypto" as crypto
import "../types.alya"
import "../core/status.alya"
import "../core/protocol.alya"
import "../core/headers.alya"
import "../router/router.alya"
import "../router/dispatch.alya"
import "../middleware/cors.alya"
import "../middleware/logger.alya"
import "../middleware/auth.alya"
import "../middleware/rate_limit.alya"
import "../middleware/request_id.alya"
@cfg(feature = "mime")
import "../middleware/static.alya"
@cfg(feature = "compress")
import "../middleware/compress.alya"
@cfg(feature = "compress")
import "../core/compression.alya"
import "./context.alya"

## Creates a new HttpServer instance
pub function server_new(port: int = 8080, host: string = "0.0.0.0", router = null)
    if router is null
        router = router_new()
    end
    return HttpServer {
        port: port,
        host: host,
        server_sock: -1,
        running: 0,
        router: router,
        options: {
            "cors_enabled": 0,
            "cors_config": null,
            "logger_enabled": 0,
            "static_enabled": 0,
            "static_prefix": "",
            "static_dir": "",
            "compression_enabled": 0,
            "compression_config": null,
            "io_timeout_ms": 5000,
            "log_format": "",
            "keep_alive_enabled": 0,
            "keep_alive_max": 100,
            "request_id_enabled": 0,
            "forwarded_enabled": 0,
            "max_header_size": 1048576,
            "max_body_size": 8388608,
            "auth_enabled": 0,
            "auth_kind": "",
            "auth_user": "",
            "auth_pass": "",
            "auth_token": "",
            "auth_secret": "",
            "rate_limit_enabled": 0,
            "rate_limiter": null
        },
        loop: null,
        tcp_server: null
    }
end

## Enables CORS middleware on the server
pub function server_enable_cors(server, origin: string = "*", methods = "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH, QUERY", headers = "Content-Type, Authorization, X-Requested-With", credentials: int = 0, max_age: int = 86400)
    server.options["cors_enabled"] = 1
    server.options["cors_config"] = cors_config_new(origin, methods, headers, credentials, max_age)
    return server
end

## Enables request logging middleware on the server
pub function server_enable_logger(server, enabled: int = 1)
    server.options["logger_enabled"] = enabled
    return server
end

## Sets a custom access-log template for the server (`{method}`, `{path}`,
## `{status}`, `{latency}`, `{remote}`, `{id}`). Empty uses the classic shape.
pub function server_set_log_format(server, format: string)
    if server is null
        return server
    end
    server.options["log_format"] = format
    return server
end

## Sets the socket I/O timeout (reads and sends) for accepted connections.
## This bounds slow clients, not handler runtime: long handlers still run
## to completion once the request is in memory.
pub function server_enable_timeout(server, timeout_ms: int = 5000)
    if server is null
        return server
    end
    server.options["io_timeout_ms"] = timeout_ms
    return server
end

## Enables static file serving middleware on the server
pub function server_enable_static(server, url_prefix: string, local_dir: string)
    server.options["static_enabled"] = 1
    server.options["static_prefix"] = url_prefix
    server.options["static_dir"] = local_dir
    return server
end

## Enables response compression middleware on the server (Brotli, Zstd, Gzip, Deflate).
##
## Requires the `compress` feature (default-on).
@cfg(feature = "compress")
pub function server_enable_compression(server, min_length: int = 256)
    server.options["compression_enabled"] = 1
    server.options["compression_config"] = compression_config_new(min_length)
    return server
end

## Enables HTTP/1.1 keep-alive on the server: responses to clients that did
## not ask for `Connection: close` keep the socket open for reuse.
## `max_requests` caps pipelined sequential requests per connection in
## `server_serve_once` (0 means unlimited). TLS connections always close.
pub function server_enable_keep_alive(server, enabled: int = 1, max_requests: int = 100)
    if server is null
        return server
    end
    server.options["keep_alive_enabled"] = enabled
    server.options["keep_alive_max"] = max_requests
    return server
end

## Returns 1 when the connection behind `ctx` should be kept open:
## keep-alive is enabled, the channel is plaintext, and the client did
## not send `Connection: close`.
pub function server_should_keep_alive(server, ctx: HttpContext) -> int
    if server is null or ctx is null or ctx.req is null
        return 0
    end
    if server.options["keep_alive_enabled"] != true
        return 0
    end
    if ctx.data is not null and ctx.data["tls_enabled"] == true
        return 0
    end
    let conn = lower(header_get(ctx.req.headers, "connection", ""))
    if conn == "close"
        return 0
    end
    return 1
end

## Enables request ID tracing on the server (mirrors/generates
## `X-Request-ID` per request via `mw_request_id`).
pub function server_enable_request_id(server, enabled: int = 1)
    if server is null
        return server
    end
    server.options["request_id_enabled"] = enabled
    return server
end

## Enables HTTP Basic authentication enforcement in `server_process`.
pub function server_enable_basic_auth(server, username: string, password: string)
    if server is null
        return server
    end
    server.options["auth_enabled"] = 1
    server.options["auth_kind"] = "basic"
    server.options["auth_user"] = username
    server.options["auth_pass"] = password
    return server
end

## Enables Bearer token authentication enforcement in `server_process`.
pub function server_enable_bearer_auth(server, token: string)
    if server is null
        return server
    end
    server.options["auth_enabled"] = 1
    server.options["auth_kind"] = "bearer"
    server.options["auth_token"] = token
    return server
end

## Enables JWT (HS256) authentication enforcement in `server_process`.
## Requires the `jwt` feature at build time; without it, JWT-gated
## requests fail closed (401).
pub function server_enable_jwt_auth(server, secret: string)
    if server is null
        return server
    end
    server.options["auth_enabled"] = 1
    server.options["auth_kind"] = "jwt"
    server.options["auth_secret"] = secret
    return server
end

## Caps accepted request header and body sizes in bytes.
## Oversized requests are rejected with `413 Content Too Large` during
## the read, before allocation can grow (DoS protection).
pub function server_enable_limits(server, max_header_size: int = 1048576, max_body_size: int = 8388608)
    if server is null
        return server
    end
    server.options["max_header_size"] = max_header_size
    server.options["max_body_size"] = max_body_size
    return server
end

## Trusts `X-Forwarded-For` / `X-Forwarded-Proto` when resolving the
## client IP in `server_process` (rate limiting and logging then see the
## real client). Enable only behind known, sanitizing proxies: clients
## can spoof these headers on direct connections.
pub function server_enable_forwarded(server, enabled: int = 1)
    if server is null
        return server
    end
    server.options["forwarded_enabled"] = enabled
    return server
end

## Enables fixed-window rate limiting in `server_process`, keyed by client
## remote address (`limit` hits per `window_ms` milliseconds).
pub function server_enable_rate_limit(server, limit: int = 100, window_ms: int = 60000)
    if server is null
        return server
    end
    server.options["rate_limit_enabled"] = 1
    server.options["rate_limiter"] = rate_limit_new(limit, window_ms)
    return server
end

## Enables TLS on the server with a PEM certificate chain and private key.
##
## When enabled, `server_start` listens through `alya-lang/tls` and
## `server_accept` terminates TLS 1.2 (RSA key exchange) before parsing
## the HTTP request. Plaintext behavior is unchanged when not enabled.
##
## ### Parameters
## - `server`: Target `HttpServer` handle (mutated in place).
## - `cert_pem`: Server certificate chain in PEM format.
## - `key_pem`: Server private key in PEM format.
##
## ### Returns
## The same server for chaining.
pub function server_enable_tls(server, cert_pem: string, key_pem: string)
    if server is null
        return server
    end
    server.options["tls_enabled"] = 1
    server.options["tls_cert_pem"] = cert_pem
    server.options["tls_key_pem"] = key_pem
    return server
end

## Returns 1 when TLS is enabled with identity material configured.
pub function server_has_tls(server) -> bool
    if server is null or server.options is null
        return false
    end
    if server.options["tls_enabled"] != true
        return false
    end
    let cert = server.options["tls_cert_pem"]
    let key = server.options["tls_key_pem"]
    if cert is null or cert == "" or key is null or key == ""
        return false
    end
    return true
end

## Starts the TCP server socket listening on configured port
pub function server_start(server, backlog: int = 128)
    if server is null
        return -1
    end
    if server_has_tls(server) == true
        let tls_srv = tls::server(server.port, server.host)
        tls::tls_server_enable_tls(tls_srv, server.options["tls_cert_pem"], server.options["tls_key_pem"], 0)
        let lsock = tls::tls_server_start(tls_srv, backlog)
        if lsock < 0
            server.running = 0
            return -1
        end
        server.options["tls_server"] = tls_srv
        server.server_sock = lsock
        server.running = 1
        return lsock
    end
    let sock = net::tcp_listen(server.port, backlog)
    if sock < 0
        server.running = 0
        return -1
    end
    server.server_sock = sock
    server.running = 1
    return sock
end

# Accepts the next incoming HTTP connection within timeout_ms milliseconds
## Returns an HttpContext instance, or null if no connection arrived or error.
## When TLS is enabled, terminates the TLS handshake first and reads the
## request through the encrypted channel.
pub function server_accept(server, timeout_ms: int = 1000)
    if server is null or server.running == 0 or server.server_sock < 0
        return null
    end

    if server_has_tls(server) == true and server.options["tls_server"] is not null
        let tls_srv = server.options["tls_server"]
        let tls_ctx = tls::tls_accept_handshake(tls_srv, timeout_ms)
        if tls_ctx is null or tls_ctx.last_error != ""
            return null
        end
        let raw = []
        let guard = 0
        while guard < 64
            let chunk = tls::tls_recv_encrypted(tls_ctx)
            if len(chunk) == 0
                break
            end
            let c = 0
            while c < len(chunk)
                raw.push(chunk[c])
                c += 1
            end
            if proto_find_bytes(raw, [13, 10, 13, 10], 0) >= 0
                break
            end
            if len(raw) > server.options["max_header_size"]
                tls::tls_send_encrypted(tls_ctx, crypto::str_to_bytes(_too_large_wire()))
                tls::close(tls_ctx)
                return null
            end
            guard += 1
        end
        if len(raw) == 0
            tls::close(tls_ctx)
            return null
        end
        let remote_addr = net::tcp_peer_addr(tls_ctx.sock)
        let req = http_parse_request(crypto::bytes_to_str(raw), remote_addr)
        let res = response_create(200, "OK")
        let ctx = context_create(req, res, tls_ctx.sock)
        ctx.data["tls_enabled"] = 1
        ctx.data["tls_ctx"] = tls_ctx
        return ctx
    end

    let ready = net::tcp_poll(server.server_sock, timeout_ms)
    if ready != true
        return null
    end

    let client_sock = net::tcp_accept(server.server_sock)
    if client_sock < 0
        return null
    end

    # Apply the configured socket timeout for reading the request
    net::tcp_set_timeout(client_sock, server.options["io_timeout_ms"])

    let ctx = server_read_request(client_sock, server.options["io_timeout_ms"], server.options["max_header_size"], server.options["max_body_size"])
    if ctx is null
        net::tcp_close(client_sock)
        return null
    end
    return ctx
end

## Reads one HTTP request from an already-connected client socket and
## wraps it in an HttpContext, or null when the peer sent nothing (closed)
## or exceeded `max_header_size` / `max_body_size` (a minimal `413`
## response is sent first, then the caller closes the socket).
## The socket is otherwise left open: the caller owns closing it. This is
## the reuse primitive behind keep-alive (`server_serve_once` loops on it).
pub function server_read_request(client_sock: int, timeout_ms: int = 5000, max_header_size: int = 1048576, max_body_size: int = 8388608)
    if client_sock < 0
        return null
    end
    net::tcp_set_timeout(client_sock, timeout_ms)

    # Read incoming request bytes (arrays preserve binary bodies)
    let raw_req = []
    while 1
        let chunk = net::tcp_recv_bytes(client_sock, 4096)
        if chunk is null or len(chunk) == 0
            break
        end
        let k = 0
        while k < len(chunk)
            raw_req.push(chunk[k])
            k += 1
        end
        if len(raw_req) > max_header_size + max_body_size
            net::tcp_send(client_sock, _too_large_wire())
            return null
        end
        # If headers end delimiter is found, stop reading for simple requests
        let delim_idx = proto_find_bytes(raw_req, [13, 10, 13, 10], 0)
        if delim_idx >= 0
            if delim_idx > max_header_size
                net::tcp_send(client_sock, _too_large_wire())
                return null
            end
            break
        end
        let alt_delim = proto_find_bytes(raw_req, [10, 10], 0)
        if alt_delim >= 0
            if alt_delim > max_header_size
                net::tcp_send(client_sock, _too_large_wire())
                return null
            end
            break
        end
    end

    if len(raw_req) == 0
        return null
    end

    # Read the declared body fully (binary uploads may span segments).
    let hsep = proto_find_bytes(raw_req, [13, 10, 13, 10], 0)
    if hsep >= 0
        let head_text = bytes_to_text_or_empty(bytes_slice(raw_req, 0, hsep))
        let want = 0
        if head_text != ""
            let hlow = lower(head_text)
            let cl_idx = _proto_find(hlow, "content-length:", 0)
            if cl_idx >= 0
                let val_start = cl_idx + 15
                let val_end = _proto_find(hlow, "\r\n", val_start)
                if val_end < 0
                    val_end = _proto_find(hlow, "\n", val_start)
                end
                if val_end < 0
                    val_end = len(hlow)
                end
                want = to_int(trim(substring(hlow, val_start, val_end - val_start)))
            end
        end
        if want > max_body_size
            net::tcp_send(client_sock, _too_large_wire())
            return null
        end
        let have = len(raw_req) - (hsep + 4)
        let guard = 0
        while want > have and guard < 2048
            let more = net::tcp_recv_bytes(client_sock, 4096)
            if more is null or len(more) == 0
                break
            end
            let m = 0
            while m < len(more)
                raw_req.push(more[m])
                m += 1
            end
            have = len(raw_req) - (hsep + 4)
            guard += 1
        end
    end

    let remote_addr = net::tcp_peer_addr(client_sock)
    let req = http_parse_request_bytes(raw_req, remote_addr)
    let res = response_create(200, "OK")

    return context_create(req, res, client_sock)
end

## Builds a minimal `413` rejection wire sent before closing oversized
## connections (no context allocation required).
function _too_large_wire() -> string
    let text = http_status_text(413)
    let body = "{\"error\": \"" + text + "\"}"
    return "HTTP/1.1 413 " + text + "\r\nContent-Type: application/json; charset=utf-8\r\nContent-Length: " + str(len(body)) + "\r\nConnection: close\r\n\r\n" + body
end

# Processes common middlewares (request ID, CORS, auth, rate limit,
# static files) and matches route on HttpContext
## Returns the RouteMatch result
pub function server_process(server, ctx: HttpContext)
    if server is null or ctx is null
        return RouteMatch { found: 0, action: "not_found", handler: null, route: "", params: {}, status: 404, allowed_methods: [] }
    end

    # Resolve proxy identity first so guards below see the real client
    if server.options["forwarded_enabled"] == true and ctx.req is not null
        ctx.req.remote_addr = ctx_client_ip(ctx)
    end

    # Trace correlation first so even rejected requests carry an ID
    if server.options["request_id_enabled"] == true
        mw_request_id(ctx)
    end

    # Apply CORS middleware if enabled
    if server.options["cors_enabled"] == true
        let preflight = mw_apply_cors(ctx, server.options["cors_config"])
        if preflight == true
            return RouteMatch { found: 1, action: "cors_preflight", handler: null, route: "", params: {}, status: 204, allowed_methods: [] }
        end
    end

    # Enforce authentication when enabled (preflight already returned above).
    # JWT without the `jwt` feature fails closed through the basic gate.
    if server.options["auth_enabled"] == true and ctx.aborted != true
        let authed = 0
        let auth_kind = server.options["auth_kind"]
        if auth_kind == "bearer"
            authed = mw_require_bearer(ctx, server.options["auth_token"])
        end
        @cfg(feature = "jwt")
        if auth_kind == "jwt"
            authed = mw_require_jwt(ctx, server.options["auth_secret"])
        end
        if auth_kind != "bearer" and auth_kind != "jwt"
            authed = mw_require_basic(ctx, server.options["auth_user"], server.options["auth_pass"])
        end
        if authed == false
            return RouteMatch { found: 0, action: "unauthorized", handler: null, route: "", params: {}, status: 401, allowed_methods: [] }
        end
    end

    # Enforce rate limiting when enabled
    if server.options["rate_limit_enabled"] == true and ctx.aborted != true
        let limiter = server.options["rate_limiter"]
        if limiter is not null
            let rl_key = ""
            if ctx.req is not null
                rl_key = ctx.req.remote_addr
            end
            if mw_apply_rate_limit(ctx, limiter, rl_key) == false
                return RouteMatch { found: 0, action: "rate_limited", handler: null, route: "", params: {}, status: 429, allowed_methods: [] }
            end
        end
    end

    # Serve static files if enabled (needs the `mime` feature)
    @cfg(feature = "mime")
    if server.options["static_enabled"] == true
        let prefix = server.options["static_prefix"]
        let dir = server.options["static_dir"]
        let served = mw_serve_static(ctx, prefix, dir)
        if served == true
            return RouteMatch { found: 1, action: "static_file", handler: null, route: "", params: {}, status: 200, allowed_methods: [] }
        end
    end

    # Route matching
    let m = router_match(server.router, ctx.req.method, ctx.req.path)
    if m.found == true
        let req = ctx.req
        req.params = m.params
    elif m.status == 405
        let res = ctx.res
        res.status_code = 405
        res.status_text = "Method Not Allowed"
        header_set(res.headers, "Allow", join(m.allowed_methods, ", "))
        res.body = "Method Not Allowed"
    else
        let res = ctx.res
        res.status_code = 404
        res.status_text = "Not Found"
        res.body = "Not Found"
    end

    return m
end

## Serializes the response in HttpContext and transmits over TCP.
## Keeps the client connection open when `server_should_keep_alive` holds
## (plaintext + enabled + client did not ask for close); otherwise closes it.
## TLS contexts send through the encrypted channel and always close.
pub function server_send(server, ctx)
    if ctx is null or ctx.client_sock < 0
        return false
    end

    # Apply compression if enabled (needs the `compress` feature)
    @cfg(feature = "compress")
    if server is not null and server.options["compression_enabled"] == true
        mw_apply_compression(ctx, server.options["compression_config"])
    end

    # Log request if logger is enabled
    if server is not null and server.options["logger_enabled"] == true
        mw_log_context_ex(ctx, -1, server.options["log_format"])
    end

    let keep = server_should_keep_alive(server, ctx)

    if ctx.data is not null and ctx.data["tls_enabled"] == true and ctx.data["tls_ctx"] is not null
        let tls_ctx = ctx.data["tls_ctx"]
        let wire = http_format_response(ctx.res)
        let rc = tls::tls_send_encrypted(tls_ctx, crypto::str_to_bytes(wire))
        tls::close(tls_ctx)
        ctx.client_sock = -1
        if rc < 0
            return false
        end
        return true
    end

    if keep == true
        header_set(ctx.res.headers, "Connection", "keep-alive")
    elif header_has(ctx.res.headers, "connection") == false
        header_set(ctx.res.headers, "Connection", "close")
    end

    # Binary responses (explicit body_bytes) travel as bytes; everything else
    # keeps the legacy string path bit-for-bit.
    let use_bytes = 0
    if ctx.res is not null and ctx.res.body_bytes is not null and len(ctx.res.body_bytes) > 0
        use_bytes = 1
    end
    if use_bytes == true
        net::tcp_send_bytes(ctx.client_sock, http_format_response_bytes(ctx.res))
    else
        net::tcp_send(ctx.client_sock, http_format_response(ctx.res))
    end
    if keep == true
        return true
    end
    net::tcp_close(ctx.client_sock)
    ctx.client_sock = -1
    return true
end

## Accepts one connection and serves sequential requests on it until the
## client closes, `max_requests` is reached, or no handler keeps it open.
## Each request runs `server_process`, then the matched handler function
## (`router_dispatch_match`), falling back to `on_request` for unmatched
## paths. Returns the number of served requests. The listener must be
## started with `server_start` first. Pipelined (unread-ahead) bytes are
## not supported: clients must wait for each response (sequential keep-alive).
pub function server_serve_once(server, timeout_ms: int = 1000, max_requests: int = 100, on_request = null) -> int
    if server is null or server.running == 0 or server.server_sock < 0
        return 0
    end
    let ready = net::tcp_poll(server.server_sock, timeout_ms)
    if ready != true
        return 0
    end
    let client_sock = net::tcp_accept(server.server_sock)
    if client_sock < 0
        return 0
    end
    net::tcp_set_timeout(client_sock, server.options["io_timeout_ms"])
    let served = 0
    let sock = client_sock
    let ctx = server_read_request(sock, server.options["io_timeout_ms"], server.options["max_header_size"], server.options["max_body_size"])
    while ctx is not null
        let m = server_process(server, ctx)
        if ctx.aborted != true and m.found == true
            router_dispatch_match(m, ctx)
        elif ctx.aborted != true and m.found == false and on_request is not null
            on_request(ctx)
        end
        server_send(server, ctx)
        served += 1
        sock = ctx.client_sock
        if sock < 0
            break
        end
        if max_requests > 0 and served >= max_requests
            break
        end
        ctx = server_read_request(sock, server.options["io_timeout_ms"], server.options["max_header_size"], server.options["max_body_size"])
    end
    if sock >= 0
        net::tcp_close(sock)
    end
    return served
end

## Serves up to `max_connections` connections via `server_serve_once`
## (`max_connections <= 0` loops forever). Returns total served requests.
pub function server_serve(server, max_connections: int = 1, timeout_ms: int = 1000, max_requests: int = 100, on_request = null) -> int
    if server is null
        return 0
    end
    let total = 0
    if max_connections <= 0
        while 1
            total += server_serve_once(server, timeout_ms, max_requests, on_request)
        end
    end
    let done = 0
    while done < max_connections
        total += server_serve_once(server, timeout_ms, max_requests, on_request)
        done += 1
    end
    return total
end

## Stops the HTTP server and releases socket resources
pub function server_close(server)
    if server is not null
        if server.options is not null and server.options["tls_server"] is not null
            tls::tls_server_close(server.options["tls_server"])
            server.options["tls_server"] = null
        end
        if server.server_sock >= 0
            net::tcp_close(server.server_sock)
            server.server_sock = -1
        end
        server.running = 0
    end
    return false
end
