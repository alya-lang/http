# HTTP Server Implementation
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/net" as net
import "../types.alya"
import "../core/protocol.alya"
import "../core/headers.alya"
import "../router/router.alya"
import "../middleware/cors.alya"
import "../middleware/logger.alya"
import "../middleware/static.alya"
import "./context.alya"

# Creates a new HttpServer instance
function server_new(port = 8080, host = "0.0.0.0", router = null)
    if router == null
        router = router_new()
    end
    return HttpServer {
        port: port,
        host: host,
        server_sock: -1,
        running: 0,
        router: router,
        options: {
            "cors_enabled": 0,
            "cors_config": null,
            "logger_enabled": 0,
            "static_enabled": 0,
            "static_prefix": "",
            "static_dir": ""
        }
    }
end

# Enables CORS middleware on the server
function server_enable_cors(server, origin = "*", methods = "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH, QUERY", headers = "Content-Type, Authorization, X-Requested-With", credentials = 0, max_age = 86400)
    server.options["cors_enabled"] = 1
    server.options["cors_config"] = cors_config_new(origin, methods, headers, credentials, max_age)
    return server
end

# Enables request logging middleware on the server
function server_enable_logger(server, enabled = 1)
    server.options["logger_enabled"] = enabled
    return server
end

# Enables static file serving middleware on the server
function server_enable_static(server, url_prefix, local_dir)
    server.options["static_enabled"] = 1
    server.options["static_prefix"] = url_prefix
    server.options["static_dir"] = local_dir
    return server
end

# Starts the TCP server socket listening on configured port
function server_start(server, backlog = 128)
    if server == null
        return -1
    end
    let sock = net::tcp_listen(server.port, backlog)
    if sock < 0
        server.running = 0
        return -1
    end
    server.server_sock = sock
    server.running = 1
    return sock
end

# Accepts the next incoming HTTP connection within timeout_ms milliseconds
# Returns an HttpContext instance, or null if no connection arrived or error
function server_accept(server, timeout_ms = 1000)
    if server == null or server.running == 0 or server.server_sock < 0
        return null
    end

    let ready = net::tcp_poll(server.server_sock, timeout_ms)
    if ready != 1
        return null
    end

    let client_sock = net::tcp_accept(server.server_sock)
    if client_sock < 0
        return null
    end

    # Set 5-second socket timeout for reading the request
    net::tcp_set_timeout(client_sock, 5000)

    # Read incoming request bytes
    let raw_req = ""
    while 1
        let chunk = net::tcp_recv(client_sock, 4096)
        if chunk == "" or len(chunk) == 0
            break
        end
        raw_req = raw_req + chunk
        # If headers end delimiter is found, stop reading for simple requests
        let delim_idx = _proto_find(raw_req, "\r\n\r\n", 0)
        if delim_idx >= 0
            break
        end
        let alt_delim = _proto_find(raw_req, "\n\n", 0)
        if alt_delim >= 0
            break
        end
    end

    if len(raw_req) == 0
        net::tcp_close(client_sock)
        return null
    end

    let remote_addr = net::tcp_peer_addr(client_sock)
    let req = http_parse_request(raw_req, remote_addr)
    let res = response_create(200, "OK")
    let ctx = context_create(req, res, client_sock)

    return ctx
end

# Processes common middlewares (CORS, static files) and matches route on HttpContext
# Returns the RouteMatch result
function server_process(server, ctx)
    if server == null or ctx == null
        return RouteMatch(0, "not_found", "", {}, 404, [])
    end

    # Apply CORS middleware if enabled
    if server.options["cors_enabled"] == 1
        let preflight = mw_apply_cors(ctx, server.options["cors_config"])
        if preflight == 1
            return RouteMatch(1, "cors_preflight", "", {}, 204, [])
        end
    end

    # Serve static files if enabled
    if server.options["static_enabled"] == 1
        let prefix = server.options["static_prefix"]
        let dir = server.options["static_dir"]
        let served = mw_serve_static(ctx, prefix, dir)
        if served == 1
            return RouteMatch(1, "static_file", "", {}, 200, [])
        end
    end

    # Route matching
    let m = router_match(server.router, ctx.req.method, ctx.req.path)
    if m.found == 1
        let req = ctx.req
        req.params = m.params
    elif m.status == 405
        let res = ctx.res
        res.status_code = 405
        res.status_text = "Method Not Allowed"
        header_set(res.headers, "Allow", join(m.allowed_methods, ", "))
        res.body = "Method Not Allowed"
    else
        let res = ctx.res
        res.status_code = 404
        res.status_text = "Not Found"
        res.body = "Not Found"
    end

    return m
end

# Serializes the response in HttpContext, transmits over TCP, and closes client connection
function server_send(server, ctx)
    if ctx == null or ctx.client_sock < 0
        return 0
    end

    # Log request if logger is enabled
    if server != null and server.options["logger_enabled"] == 1
        mw_log_context(ctx)
    end

    let wire = http_format_response(ctx.res)
    net::tcp_send(ctx.client_sock, wire)
    net::tcp_close(ctx.client_sock)
    ctx.client_sock = -1
    return 1
end

# Stops the HTTP server and releases socket resources
function server_close(server)
    if server != null
        if server.server_sock >= 0
            net::tcp_close(server.server_sock)
            server.server_sock = -1
        end
        server.running = 0
    end
    return 0
end
