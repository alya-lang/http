## HTTP Router Implementation.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "./route.alya"

## Creates a new HttpRouter instance.
pub function router_new(not_found_action: string = "not_found")
    return HttpRouter {
        routes: [],
        not_found_action: not_found_action
    }
end

## Adds a new route rule to the router.
pub function router_add(r, method, pattern: string, action)
    if r is null
        return null
    end
    let route = route_new(method, pattern, action)
    push(r.routes, route)
    return r
end

## Registers a GET route.
pub function router_get(r, pattern: string, action)
    return router_add(r, "GET", pattern, action)
end

## Registers a POST route.
pub function router_post(r, pattern: string, action)
    return router_add(r, "POST", pattern, action)
end

## Registers a PUT route.
pub function router_put(r, pattern: string, action)
    return router_add(r, "PUT", pattern, action)
end

## Registers a DELETE route.
pub function router_delete(r, pattern: string, action)
    return router_add(r, "DELETE", pattern, action)
end

## Registers a PATCH route.
pub function router_patch(r, pattern: string, action)
    return router_add(r, "PATCH", pattern, action)
end

## Registers a HEAD route.
pub function router_head(r, pattern: string, action)
    return router_add(r, "HEAD", pattern, action)
end

## Registers an OPTIONS route.
pub function router_options(r, pattern: string, action)
    return router_add(r, "OPTIONS", pattern, action)
end

## Registers a QUERY route (IETF safe method with request body).
pub function router_query(r, pattern: string, action)
    return router_add(r, "QUERY", pattern, action)
end

## Registers a route matching ANY HTTP method.
pub function router_any(r, pattern: string, action)
    return router_add(r, "ANY", pattern, action)
end

## Joins prefix and path pattern cleanly (e.g. "/api" + "/users/:id" -> "/api/users/:id").
pub function _router_join_prefix(prefix: string, pattern: string)
    if prefix is null or prefix == "" or prefix == "/"
        return pattern
    end
    let p = prefix
    if substring(p, len(p) - 1, 1) == "/"
        p = substring(p, 0, len(p) - 1)
    end
    let pat = pattern
    if substring(pat, 0, 1) == "/"
        pat = substring(pat, 1, len(pat) - 1)
    end
    if pat == ""
        return p
    end
    return p + "/" + pat
end

## Adds a route under a group prefix.
pub function router_group_add(r, prefix: string, method, pattern: string, action)
    let full_pattern = _router_join_prefix(prefix, pattern)
    return router_add(r, method, full_pattern, action)
end

## Helper to check if array contains item.
pub function _arr_has(arr, item)
    let i = 0
    while i < len(arr)
        if arr[i] == item
            return 1
        end
        i += 1
    end
    return 0
end

## Matches a request method and path against registered routes.
## Returns a RouteMatch struct.
pub function router_match(r, method, path: string)
    if r is null
        return RouteMatch { found: 0, action: "not_found", route: "", params: {}, status: 404, allowed_methods: [] }
    end

    let raw_m = upper(trim(method))
    let req_method = "GET"
    when raw_m
        is "GET" then req_method = "GET"
        is "POST" then req_method = "POST"
        is "PUT" then req_method = "PUT"
        is "DELETE" then req_method = "DELETE"
        is "PATCH" then req_method = "PATCH"
        is "HEAD" then req_method = "HEAD"
        is "OPTIONS" then req_method = "OPTIONS"
        else req_method = raw_m
    end
    let req_segs = route_split_path(path)
    let allowed_methods = []

    let i = 0
    let r_count = len(r.routes)
    while i < r_count
        let rt = r.routes[i]
        let res = route_match_segments(rt.segments, req_segs)
        if res["matched"] == 1
            if rt.method == req_method or rt.method == "ANY" or rt.method == "*"
                return RouteMatch { found: 1, action: rt.action, route: rt.pattern, params: res["params"], status: 200, allowed_methods: [] }
            else
                if _arr_has(allowed_methods, rt.method) == 0
                    push(allowed_methods, rt.method)
                end
            end
        end
        i += 1
    end

    # If path matched routes for other methods, return 405 Method Not Allowed
    if len(allowed_methods) > 0
        return RouteMatch { found: 0, action: "method_not_allowed", route: "", params: {}, status: 405, allowed_methods: allowed_methods }
    end

    # Otherwise return 404 Not Found
    return RouteMatch { found: 0, action: r.not_found_action, route: "", params: {}, status: 404, allowed_methods: [] }
end
