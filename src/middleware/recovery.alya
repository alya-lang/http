# HTTP Error Recovery Middleware
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "../core/headers.alya"

# Formats a safe JSON error response and sets 500 status code
function mw_apply_recovery(ctx, err_message = "Internal Server Error")
    if ctx == null or ctx.res == null
        return null
    end

    let res = ctx.res
    res.status_code = 500
    res.status_text = "Internal Server Error"
    header_set(res.headers, "Content-Type", "application/json; charset=utf-8")
    res.body = "{\"error\": \"" + err_message + "\"}"
    ctx.aborted = 1
    return ctx
end
