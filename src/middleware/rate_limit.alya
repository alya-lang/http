## HTTP Fixed-Window Rate Limiting Middleware.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "../core/headers.alya"

## In-memory fixed-window rate limiter.
##
## ### Fields
## - `limit`: Maximum allowed hits per window integer.
## - `window_ms`: Window length in milliseconds integer.
## - `start_ms`: Window start timestamp (`clock_ms`) integer.
## - `counts`: Hit counters map keyed by client key.
pub struct RateLimiter
    limit: int,
    window_ms: int,
    start_ms: int,
    counts: map
end

## Creates a new RateLimiter allowing `limit` hits per `window_ms` window.
pub function rate_limit_new(limit: int = 100, window_ms: int = 60000) -> RateLimiter
    return RateLimiter {
        limit: limit,
        window_ms: window_ms,
        start_ms: clock_ms(),
        counts: {}
    }
end

## Records one hit for `key` and returns 1 when under the limit, 0 when denied.
## The window resets automatically once `window_ms` has elapsed.
pub function rate_limit_check(limiter: RateLimiter, key: string = "default") -> int
    if limiter is null
        return 1
    end
    if key is null or key == ""
        key = "default"
    end
    let now = clock_ms()
    if now - limiter.start_ms >= limiter.window_ms
        limiter.start_ms = now
        limiter.counts = {}
    end
    let seen = 0
    if has(limiter.counts, key)
        seen = limiter.counts[key]
    end
    seen += 1
    limiter.counts[key] = seen
    if seen > limiter.limit
        return 0
    end
    return 1
end

## Returns the whole seconds until the current window resets (minimum 1).
pub function rate_limit_retry_after(limiter: RateLimiter) -> int
    if limiter is null
        return 1
    end
    let remaining = limiter.window_ms - (clock_ms() - limiter.start_ms)
    if remaining < 0
        remaining = 0
    end
    return to_int(remaining / 1000) + 1
end

## Applies rate limiting to an HttpContext using the client remote address
## (or `key` when given) as the bucket key.
## Returns 1 when allowed, otherwise responds 429 with a `Retry-After`
## header, aborts the context, and returns 0.
pub function mw_apply_rate_limit(ctx: HttpContext, limiter: RateLimiter, key: string = "") -> int
    if limiter is null
        return 1
    end
    if key is null or key == ""
        key = "default"
        if ctx is not null and ctx.req is not null and ctx.req.remote_addr != ""
            key = ctx.req.remote_addr
        end
    end
    if rate_limit_check(limiter, key) == true
        return 1
    end
    if ctx is not null and ctx.res is not null
        let res = ctx.res
        res.status_code = 429
        res.status_text = "Too Many Requests"
        header_set(res.headers, "Retry-After", str(rate_limit_retry_after(limiter)))
        header_set(res.headers, "Content-Type", "application/json; charset=utf-8")
        res.body = "{\"error\": \"Too Many Requests\"}"
        ctx.aborted = 1
    end
    return 0
end
