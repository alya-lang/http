## CORS (Cross-Origin Resource Sharing) Middleware.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../core/headers.alya"

## Configuration options for Cross-Origin Resource Sharing (CORS).
##
## ### Fields
## - `allow_origin`: Permitted origin string.
## - `allow_methods`: Permitted method list string.
## - `allow_headers`: Permitted header list string.
## - `allow_credentials`: `1` permits credentials, `0` otherwise.
## - `max_age`: Preflight cache seconds integer.
pub struct CorsConfig
    allow_origin: string,
    allow_methods: string,
    allow_headers: string,
    allow_credentials: int,
    max_age: int
end

## Creates a new CorsConfig struct with sensible defaults.
pub function cors_config_new(origin: string = "*", methods = "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH, QUERY", headers = "Content-Type, Authorization, X-Requested-With", credentials: int = 0, max_age: int = 86400)
    return CorsConfig {
        allow_origin: origin,
        allow_methods: methods,
        allow_headers: headers,
        allow_credentials: credentials,
        max_age: max_age
    }
end

## Applies CORS headers to HttpContext and handles preflight OPTIONS requests.
## Returns 1 if request was preflight and aborted, 0 if request should continue.
pub function mw_apply_cors(ctx, config = null)
    if ctx is null
        return 0
    end

    if config is null
        config = cors_config_new()
    end

    let res = ctx.res
    header_set(res.headers, "Access-Control-Allow-Origin", config.allow_origin)
    header_set(res.headers, "Access-Control-Allow-Methods", config.allow_methods)
    header_set(res.headers, "Access-Control-Allow-Headers", config.allow_headers)

    if config.allow_credentials == 1
        header_set(res.headers, "Access-Control-Allow-Credentials", "true")
    end

    if config.max_age > 0
        header_set(res.headers, "Access-Control-Max-Age", str(config.max_age))
    end

    # Handle preflight OPTIONS request
    if ctx.req is not null and ctx.req.method == "OPTIONS"
        res.status_code = 204
        res.status_text = "No Content"
        res.body = ""
        ctx.aborted = 1
        return 1
    end

    return 0
end
