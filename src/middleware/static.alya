# Static File Serving Middleware
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "../core/headers.alya"
import "mime" as mime_pkg

# Internal helper to find substring
function _static_find(s, target, start_idx = 0)
    let slen = len(s)
    let tlen = len(target)
    if tlen == 0
        return start_idx
    end
    let i = start_idx
    while i + tlen <= slen
        if substring(s, i, tlen) == target
            return i
        end
        i += 1
    end
    return -1
end

# Normalizes and safely joins directory with requested relative path, rejecting directory traversal
function _safe_static_path(local_dir, rel_path)
    # Reject directory traversal attempts
    if _static_find(rel_path, "..", 0) >= 0
        return ""
    end

    let d = local_dir
    if len(d) > 0 and (substring(d, len(d) - 1, 1) == "/" or substring(d, len(d) - 1, 1) == "\\")
        d = substring(d, 0, len(d) - 1)
    end

    let p = rel_path
    if len(p) > 0 and (substring(p, 0, 1) == "/" or substring(p, 0, 1) == "\\")
        p = substring(p, 1, len(p) - 1)
    end

    if p == ""
        return d
    end
    return d + "/" + p
end

# Attempts to serve a static file for the current request
# Returns 1 if file was found and served, 0 otherwise
function mw_serve_static(ctx, url_prefix, local_dir)
    if ctx == null or ctx.req == null
        return 0
    end

    let req_path = ctx.req.path
    let pre_len = len(url_prefix)

    # Check if request path begins with url_prefix
    if len(req_path) < pre_len or substring(req_path, 0, pre_len) != url_prefix
        return 0
    end

    let rel_path = substring(req_path, pre_len, len(req_path) - pre_len)
    if rel_path == "" or rel_path == "/"
        rel_path = "index.html"
    end

    let full_path = _safe_static_path(local_dir, rel_path)
    if full_path == ""
        # Traversal attempt: respond with 403
        let res = ctx.res
        res.status_code = 403
        res.status_text = "Forbidden"
        res.body = "Forbidden"
        header_set(res.headers, "Content-Type", "text/plain")
        ctx.aborted = 1
        return 1
    end

    if file_exists(full_path) == 1
        let ctype = mime_pkg::content_type(full_path, "application/octet-stream")
        let res = ctx.res
        let accept_enc = ""
        if ctx.req != null and ctx.req.headers != null
            accept_enc = lower(header_get(ctx.req.headers, "accept-encoding", ""))
        end

        # Pre-compressed assets: Brotli (.br)
        if _static_find(accept_enc, "br", 0) >= 0 and file_exists(full_path + ".br") == 1
            let content = read_file(full_path + ".br")
            res.status_code = 200
            res.status_text = "OK"
            res.body = content
            header_set(res.headers, "Content-Type", ctype)
            header_set(res.headers, "Content-Encoding", "br")
            header_set(res.headers, "Vary", "Accept-Encoding")
            header_set(res.headers, "Content-Length", str(len(content)))
            ctx.aborted = 1
            return 1
        end

        # Pre-compressed assets: Gzip (.gz)
        if _static_find(accept_enc, "gzip", 0) >= 0 and file_exists(full_path + ".gz") == 1
            let content = read_file(full_path + ".gz")
            res.status_code = 200
            res.status_text = "OK"
            res.body = content
            header_set(res.headers, "Content-Type", ctype)
            header_set(res.headers, "Content-Encoding", "gzip")
            header_set(res.headers, "Vary", "Accept-Encoding")
            header_set(res.headers, "Content-Length", str(len(content)))
            ctx.aborted = 1
            return 1
        end

        # Uncompressed standard file
        let content = read_file(full_path)
        res.status_code = 200
        res.status_text = "OK"
        res.body = content
        header_set(res.headers, "Content-Type", ctype)
        header_set(res.headers, "Content-Length", str(len(content)))
        ctx.aborted = 1
        return 1
    end

    return 0
end
