## HTTP Compression Middleware.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../core/headers.alya"
import "../core/compression.alya"

## Configuration for response compression middleware.
##
## ### Fields
## - `min_length`: Minimum body bytes before compressing.
## - `encodings`: Supported encoding array.
pub struct CompressionConfig
    min_length: int,
    encodings
end

## Creates a new CompressionConfig struct with sensible defaults.
pub function compression_config_new(min_length: int = 256)
    return CompressionConfig {
        min_length: min_length,
        encodings: ["br", "zstd", "gzip", "deflate"]
    }
end

## Applies HTTP compression to HttpContext response based on request Accept-Encoding.
## Returns 1 if compression was applied, 0 otherwise.
pub function mw_apply_compression(ctx, config = null)
    if ctx is null or ctx.res is null or ctx.req is null
        return 0
    end

    let res = ctx.res
    let req = ctx.req

    if res.body is null or len(res.body) == 0
        return 0
    end

    # Do not compress if response is already encoded
    if header_has(res.headers, "content-encoding")
        return 0
    end

    if config is null
        config = compression_config_new()
    end

    # Skip if response body length is below compression threshold
    if len(res.body) < config.min_length
        return 0
    end

    let accept_enc = header_get(req.headers, "accept-encoding", "")
    if accept_enc == ""
        return 0
    end

    let chosen_enc = http_negotiate_encoding(accept_enc)
    if chosen_enc == ""
        return 0
    end

    let comp_bytes = http_compress(res.body, chosen_enc)
    if comp_bytes is null or len(comp_bytes) == 0
        return 0
    end

    # Set response compression headers
    header_set(res.headers, "Content-Encoding", chosen_enc)
    header_set(res.headers, "Vary", "Accept-Encoding")
    header_set(res.headers, "Content-Length", str(len(comp_bytes)))

    # Store raw compressed bytes in context data dictionary
    let ctx_data = ctx.data
    if ctx_data is not null
        ctx_data["compressed_body"] = comp_bytes
        ctx_data["compression_encoding"] = chosen_enc
    end

    return 1
end
