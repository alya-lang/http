## HTTP Request Logger Middleware.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

## Formats a structured log message string for an HTTP request.
pub function mw_format_log(method, path: string, status: int, latency_ms: int = -1, remote_addr: string = "") -> string
    let msg = "[HTTP] " + method + " " + path + " " + str(status)
    if latency_ms >= 0
        msg += " - " + str(latency_ms) + "ms"
    end
    if remote_addr != ""
        msg += " (" + remote_addr + ")"
    end
    return msg
end

# Replaces every occurrence of a `{token}` placeholder in a format string.
function _log_replace_all(format: string, token: string, val: string) -> string
    let needle = "{" + token + "}"
    let out = ""
    let rest = format
    while 1
        let idx = _log_find(rest, needle)
        if idx < 0
            out += rest
            break
        end
        out += substring(rest, 0, idx) + val
        rest = substring(rest, idx + len(needle), len(rest) - (idx + len(needle)))
    end
    return out
end

# Finds the first occurrence of a substring, or -1.
function _log_find(s: string, target: string) -> int
    let slen = len(s)
    let tlen = len(target)
    if tlen == 0
        return 0
    end
    let i = 0
    while i + tlen <= slen
        if substring(s, i, tlen) == target
            return i
        end
        i += 1
    end
    return -1
end

## Formats a log line from a custom template with `{method}`, `{path}`,
## `{status}`, `{latency}`, `{remote}`, and `{id}` placeholders.
## An empty template falls back to the classic `mw_format_log` shape.
## Unknown placeholders are left intact. Negative latency renders as `-`.
pub function mw_format_log_ex(method, path: string, status: int, latency_ms: int = -1, remote_addr: string = "", request_id: string = "", format: string = "") -> string
    if format is null or format == ""
        return mw_format_log(method, path, status, latency_ms, remote_addr)
    end
    let latency_str = "-"
    if latency_ms >= 0
        latency_str = str(latency_ms) + "ms"
    end
    let line = format
    line = _log_replace_all(line, "method", method)
    line = _log_replace_all(line, "path", path)
    line = _log_replace_all(line, "status", str(status))
    line = _log_replace_all(line, "latency", latency_str)
    line = _log_replace_all(line, "remote", remote_addr)
    line = _log_replace_all(line, "id", request_id)
    return line
end

## Logs an HttpContext request and response lifecycle.
pub function mw_log_context(ctx: HttpContext, latency_ms: int = -1)
    if ctx is null or ctx.req is null
        return null
    end

    let method = ctx.req.method
    let path = ctx.req.path
    let status = 200
    if ctx.res is not null
        let res = ctx.res
        status = res.status_code
    end
    let remote = ctx.req.remote_addr

    let line = mw_format_log(method, path, status, latency_ms, remote)
    say line
    return line
end

## Logs an HttpContext with a custom format template (see `mw_format_log_ex`).
## The `{id}` placeholder reads `ctx.data["request_id"]` when present.
pub function mw_log_context_ex(ctx: HttpContext, latency_ms: int = -1, format: string = "")
    if ctx is null or ctx.req is null
        return null
    end

    let method = ctx.req.method
    let path = ctx.req.path
    let status = 200
    if ctx.res is not null
        let res = ctx.res
        status = res.status_code
    end
    let remote = ctx.req.remote_addr
    let req_id = ""
    if ctx.data is not null and has(ctx.data, "request_id")
        req_id = ctx.data["request_id"]
    end

    let line = mw_format_log_ex(method, path, status, latency_ms, remote, req_id, format)
    say line
    return line
end
