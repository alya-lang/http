## High-Level RFC 6455 WebSocket Connection & Protocol Driver.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/net" as net
import "./frame.alya"

# WebSocket Lifecycle States
pub enum WebSocketState
    Connecting = 0
    Open = 1
    Closing = 2
    Closed = 3
end

# Represents a bidirectional WebSocket connection
pub struct WebSocketConnection
    stream
    is_server: int
    state: int
    tag: string
    data
    buffer
    write_fn
    close_fn
    on_message_cb
    on_close_cb
    on_ping_cb
    on_pong_cb
    on_error_cb
end

# ═══════════════════════════════════════════════════════════════
# Factory & Lifecycle
# ═══════════════════════════════════════════════════════════════

function _ws_default_write(s, data)
    return net::tcp_send(s, data)
end

function _ws_default_close(s)
    return net::tcp_close(s)
end

## Creates and initializes a new WebSocket connection wrapper
pub function ws_connection_new(stream, is_server: int = 1, write_fn = null, close_fn = null)
    if write_fn is null
        write_fn = _ws_default_write
    end
    if close_fn is null
        close_fn = _ws_default_close
    end
    return WebSocketConnection {
        stream: stream,
        is_server: is_server,
        state: WebSocketState.Open,
        tag: "ws_conn",
        data: null,
        buffer: "",
        write_fn: write_fn,
        close_fn: close_fn,
        on_message_cb: null,
        on_close_cb: null,
        on_ping_cb: null,
        on_pong_cb: null,
        on_error_cb: null
    }
end

## Creates a WebSocket connection over a raw integer TCP socket fd
pub function ws_connection_from_socket(sock_fd: int, is_server: int = 1)
    return ws_connection_new(sock_fd, is_server, _ws_default_write, _ws_default_close)
end

function _ws_raw_write(ws: WebSocketConnection, data)
    if ws is null or ws.stream is null
        return -1
    end
    let w_fn = ws.write_fn
    if w_fn is not null
        return w_fn(ws.stream, data)
    end
    return -1
end

function _ws_raw_close(ws: WebSocketConnection)
    if ws is null or ws.stream is null
        return 0
    end
    let c_fn = ws.close_fn
    if c_fn is not null
        return c_fn(ws.stream)
    end
    return 0
end

# ═══════════════════════════════════════════════════════════════
# Transmission Operations
# ═══════════════════════════════════════════════════════════════

## Transmits a UTF-8 text message over the WebSocket connection
pub function ws_send(ws: WebSocketConnection, text: string)
    if ws is null or ws.state != WebSocketState.Open
        return 0
    end
    let mask = ws.is_server == 1 ? 0 : 1
    let wire = ws_encode_text(text, mask)
    return _ws_raw_write(ws, wire)
end

## Transmits a binary message over the WebSocket connection
pub function ws_send_binary(ws: WebSocketConnection, data)
    if ws is null or ws.state != WebSocketState.Open
        return 0
    end
    let mask = ws.is_server == 1 ? 0 : 1
    let wire = ws_encode_binary(data, mask)
    return _ws_raw_write(ws, wire)
end

## Sends a ping heartbeat frame over the WebSocket connection
pub function ws_ping(ws: WebSocketConnection, data: string = "")
    if ws is null or ws.state != WebSocketState.Open
        return 0
    end
    let mask = ws.is_server == 1 ? 0 : 1
    let wire = ws_encode_ping(data, mask)
    return _ws_raw_write(ws, wire)
end

## Sends a pong heartbeat frame over the WebSocket connection
pub function ws_pong(ws: WebSocketConnection, data: string = "")
    if ws is null or ws.state != WebSocketState.Open
        return 0
    end
    let mask = ws.is_server == 1 ? 0 : 1
    let wire = ws_encode_pong(data, mask)
    return _ws_raw_write(ws, wire)
end

## Initiates or completes a WebSocket close handshake
pub function ws_close(ws: WebSocketConnection, code: int = 1000, reason: string = "")
    if ws is null or ws.state == WebSocketState.Closed
        return 0
    end
    let mask = ws.is_server == 1 ? 0 : 1
    let wire = ws_encode_close(code, reason, mask)
    _ws_raw_write(ws, wire)

    ws.state = WebSocketState.Closed
    _ws_raw_close(ws)

    let cb = ws.on_close_cb
    if cb is not null
        cb(ws, code, reason)
    end
    return 1
end

# ═══════════════════════════════════════════════════════════════
# Stream Feeding & Frame Ingestion
# ═══════════════════════════════════════════════════════════════

## Feeds incoming network data into the connection buffer and processes all frames
pub function ws_feed(ws: WebSocketConnection, chunk)
    if ws is null or chunk is null or len(chunk) == 0
        return 0
    end

    ws.buffer = ws.buffer + chunk
    let frames_processed = 0

    while len(ws.buffer) > 0
        let parsed = ws_frame_parse(ws.buffer, 0)
        let frame = parsed[0]
        let consumed = parsed[1]

        if frame is null or consumed == 0
            # Buffer contains partial frame, wait for more chunks
            break
        end

        # Advance buffer by consumed bytes
        if consumed >= len(ws.buffer)
            ws.buffer = ""
        else
            ws.buffer = substring(ws.buffer, consumed, len(ws.buffer) - consumed)
        end

        frames_processed += 1

        # Process frame based on OpCode
        when frame.opcode
            is WebSocketOpCode.Text then
                let cb = ws.on_message_cb
                if cb is not null
                    cb(ws, frame.payload, 0)
                end
            is WebSocketOpCode.Binary then
                let cb = ws.on_message_cb
                if cb is not null
                    cb(ws, frame.payload, 1)
                end
            is WebSocketOpCode.Ping then
                # Automatic RFC 6455 Ping-Pong reply
                ws_pong(ws, frame.payload)
                let cb = ws.on_ping_cb
                if cb is not null
                    cb(ws, frame.payload)
                end
            is WebSocketOpCode.Pong then
                let cb = ws.on_pong_cb
                if cb is not null
                    cb(ws, frame.payload)
                end
            is WebSocketOpCode.Close then
                let code = 1000
                let reason = ""
                if frame.len >= 2
                    let b0 = ord(char_at(frame.payload, 0))
                    let b1 = ord(char_at(frame.payload, 1))
                    code = bit_or(bit_shl(b0, 8), b1)
                    if frame.len > 2
                        reason = substring(frame.payload, 2, frame.len - 2)
                    end
                end
                ws_close(ws, code, reason)
                break
        end
    end

    return frames_processed
end

# ═══════════════════════════════════════════════════════════════
# Event Registration & Struct Methods
# ═══════════════════════════════════════════════════════════════

## Registers a text/binary message callback on a connection.
pub function ws_on_message(ws: WebSocketConnection, callback)
    if ws is not null
        ws.on_message_cb = callback
    end
    return ws
end

## Registers a close callback on a connection.
pub function ws_on_close(ws: WebSocketConnection, callback)
    if ws is not null
        ws.on_close_cb = callback
    end
    return ws
end

## Registers a ping callback on a connection.
pub function ws_on_ping(ws: WebSocketConnection, callback)
    if ws is not null
        ws.on_ping_cb = callback
    end
    return ws
end

## Registers a pong callback on a connection.
pub function ws_on_pong(ws: WebSocketConnection, callback)
    if ws is not null
        ws.on_pong_cb = callback
    end
    return ws
end

## Registers an error callback on a connection.
pub function ws_on_error(ws: WebSocketConnection, callback)
    if ws is not null
        ws.on_error_cb = callback
    end
    return ws
end

## Sends a text frame on this connection.
pub function WebSocketConnection.send(self: WebSocketConnection, text: string)
    return ws_send(self, text)
end

## Sends a binary frame on this connection.
pub function WebSocketConnection.send_binary(self: WebSocketConnection, data)
    return ws_send_binary(self, data)
end

## Sends a ping frame on this connection.
pub function WebSocketConnection.ping(self: WebSocketConnection, data: string = "")
    return ws_ping(self, data)
end

## Sends a pong frame on this connection.
pub function WebSocketConnection.pong(self: WebSocketConnection, data: string = "")
    return ws_pong(self, data)
end

## Closes this connection with a status code.
pub function WebSocketConnection.close(self: WebSocketConnection, code: int = 1000, reason: string = "")
    return ws_close(self, code, reason)
end

## Feeds received bytes into this connection.
pub function WebSocketConnection.feed(self: WebSocketConnection, chunk)
    return ws_feed(self, chunk)
end

## Registers a message callback on this connection.
pub function WebSocketConnection.on_message(self: WebSocketConnection, callback)
    return ws_on_message(self, callback)
end

## Registers a close callback on this connection.
pub function WebSocketConnection.on_close(self: WebSocketConnection, callback)
    return ws_on_close(self, callback)
end

## Registers a ping callback on this connection.
pub function WebSocketConnection.on_ping(self: WebSocketConnection, callback)
    return ws_on_ping(self, callback)
end

## Registers a pong callback on this connection.
pub function WebSocketConnection.on_pong(self: WebSocketConnection, callback)
    return ws_on_pong(self, callback)
end

## Registers an error callback on this connection.
pub function WebSocketConnection.on_error(self: WebSocketConnection, callback)
    return ws_on_error(self, callback)
end
