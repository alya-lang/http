## High-Level RFC 6455 WebSocket Connection & Protocol Driver.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/net" as net
import "./frame.alya"

# WebSocket Lifecycle States
pub enum WebSocketState
    Connecting = 0
    Open = 1
    Closing = 2
    Closed = 3
end

# Represents a bidirectional WebSocket connection
pub struct WebSocketConnection
    stream
    is_server: int
    state: int
    tag: string
    data
    buffer
    buffer_bytes
    write_fn
    write_bytes_fn
    close_fn
    on_message_cb
    on_close_cb
    on_ping_cb
    on_pong_cb
    on_error_cb
    frag_opcode: int
    frag_buffer
    frag_buf_bytes
end

# ═══════════════════════════════════════════════════════════════
# Factory & Lifecycle
# ═══════════════════════════════════════════════════════════════

function _ws_default_write(s, data)
    return net::tcp_send(s, data)
end

function _ws_default_close(s)
    return net::tcp_close(s)
end

## Creates and initializes a new WebSocket connection wrapper
pub function ws_connection_new(stream, is_server: int = 1, write_fn = null, close_fn = null, write_bytes_fn = null)
    if write_fn is null
        write_fn = _ws_default_write
    end
    if close_fn is null
        close_fn = _ws_default_close
    end
    return WebSocketConnection {
        stream: stream,
        is_server: is_server,
        state: WebSocketState.Open,
        tag: "ws_conn",
        data: null,
        buffer: "",
        buffer_bytes: [],
        write_fn: write_fn,
        write_bytes_fn: write_bytes_fn,
        close_fn: close_fn,
        on_message_cb: null,
        on_close_cb: null,
        on_ping_cb: null,
        on_pong_cb: null,
        on_error_cb: null,
        frag_opcode: -1,
        frag_buffer: "",
        frag_buf_bytes: []
    }
end

## Creates a WebSocket connection over a raw integer TCP socket fd
pub function ws_connection_from_socket(sock_fd: int, is_server: int = 1)
    return ws_connection_new(sock_fd, is_server, _ws_default_write, _ws_default_close)
end

function _ws_raw_write(ws: WebSocketConnection, data)
    if ws is null or ws.stream is null
        return -1
    end
    let w_fn = ws.write_fn
    if w_fn is not null
        return w_fn(ws.stream, data)
    end
    return -1
end

function _ws_raw_close(ws: WebSocketConnection)
    if ws is null or ws.stream is null
        return false
    end
    let c_fn = ws.close_fn
    if c_fn is not null
        return c_fn(ws.stream)
    end
    return false
end

# ═══════════════════════════════════════════════════════════════
# Transmission Operations
# ═══════════════════════════════════════════════════════════════

## Transmits a UTF-8 text message over the WebSocket connection
pub function ws_send(ws: WebSocketConnection, text: string)
    if ws is null or ws.state != WebSocketState.Open
        return false
    end
    let mask = ws.is_server == true ? false : true
    let wire = ws_encode_text(text, mask)
    return _ws_raw_write(ws, wire)
end

## Transmits a binary message over the WebSocket connection
pub function ws_send_binary(ws: WebSocketConnection, data)
    if ws is null or ws.state != WebSocketState.Open
        return false
    end
    let mask = ws.is_server == true ? false : true
    let wire = ws_encode_binary(data, mask)
    return _ws_raw_write(ws, wire)
end

## Sends a ping heartbeat frame over the WebSocket connection
pub function ws_ping(ws: WebSocketConnection, data: string = "")
    if ws is null or ws.state != WebSocketState.Open
        return false
    end
    let mask = ws.is_server == true ? false : true
    let wire = ws_encode_ping(data, mask)
    return _ws_raw_write(ws, wire)
end

## Sends a pong heartbeat frame over the WebSocket connection
pub function ws_pong(ws: WebSocketConnection, data: string = "")
    if ws is null or ws.state != WebSocketState.Open
        return false
    end
    let mask = ws.is_server == true ? false : true
    let wire = ws_encode_pong(data, mask)
    return _ws_raw_write(ws, wire)
end

## Initiates or completes a WebSocket close handshake
pub function ws_close(ws: WebSocketConnection, code: int = 1000, reason: string = "")
    if ws is null or ws.state == WebSocketState.Closed
        return false
    end
    let mask = ws.is_server == true ? false : true
    let wire = ws_encode_close(code, reason, mask)
    _ws_raw_write(ws, wire)

    ws.state = WebSocketState.Closed
    _ws_raw_close(ws)

    let cb = ws.on_close_cb
    if cb is not null
        cb(ws, code, reason)
    end
    return true
end

# ═══════════════════════════════════════════════════════════════
# Stream Feeding & Frame Ingestion
# ═══════════════════════════════════════════════════════════════

# Validates one parsed frame against RFC 6455 §5.1/§5.3/§5.4/§5.5.
# Returns "" when valid, otherwise the protocol-error reason.
# Shared by the string and bytes feed paths.
function _ws_check_frame(ws: WebSocketConnection, frame) -> string
    let op = frame.opcode
    if op >= 8
        if op != WebSocketOpCode.Close and op != WebSocketOpCode.Ping and op != WebSocketOpCode.Pong
            return "unknown opcode " + str(op)
        end
        # Control frames MUST NOT be fragmented and carry at most 125 bytes.
        if frame.fin == false or frame.len > 125
            return "invalid control frame (fragmented or oversized)"
        end
    elif op != WebSocketOpCode.Continuation and op != WebSocketOpCode.Text and op != WebSocketOpCode.Binary
        return "unknown opcode " + str(op)
    end

    # Frames from the client MUST be masked; frames from the server MUST NOT be.
    if ws.is_server == true
        if frame.masked == false
            return "client frame not masked"
        end
    else
        if frame.masked == true
            return "protocol error"
        end
    end
    return ""
end

# Fails the connection with a 1002 (protocol error) close after notifying
# the error callback, if any. Callers must stop feeding after this.
function _ws_protocol_error(ws: WebSocketConnection, reason: string)
    let cb = ws.on_error_cb
    if cb is not null
        cb(ws, reason)
    end
    ws_close(ws, 1002, reason)
end

# Bytes-wire variant: the close handshake itself stays NUL-free by construction.
function _ws_protocol_error_bytes(ws: WebSocketConnection, reason: string)
    let cb = ws.on_error_cb
    if cb is not null
        cb(ws, reason)
    end
    ws_close_bytes(ws, 1002)
end

## Feeds incoming network data into the connection buffer and processes all frames
pub function ws_feed(ws: WebSocketConnection, chunk)
    if ws is null or chunk is null or len(chunk) == 0
        return false
    end

    ws.buffer += chunk
    let frames_processed = 0

    while len(ws.buffer) > 0
        let parsed = ws_frame_parse(ws.buffer, 0)
        let frame = parsed[0]
        let consumed = parsed[1]

        if frame is null or consumed == false
            # Buffer contains partial frame, wait for more chunks
            break
        end

        # Advance buffer by consumed bytes
        if consumed >= len(ws.buffer)
            ws.buffer = ""
        else
            ws.buffer = substring(ws.buffer, consumed, len(ws.buffer) - consumed)
        end

        frames_processed += 1

        let op = frame.opcode

        let violation = _ws_check_frame(ws, frame)
        if violation != ""
            _ws_protocol_error(ws, violation)
            break
        end

        # ── RFC 6455 §5.4: message fragmentation ──
        if op == WebSocketOpCode.Continuation
            if ws.frag_opcode < 0
                _ws_protocol_error(ws, "unexpected continuation frame")
                break
            end
            ws.frag_buffer += frame.payload
            if frame.fin == true
                let fcb = ws.on_message_cb
                if fcb is not null
                    let fis_bin = 0
                    if ws.frag_opcode == WebSocketOpCode.Binary
                        fis_bin = 1
                    end
                    fcb(ws, ws.frag_buffer, fis_bin)
                end
                ws.frag_opcode = -1
                ws.frag_buffer = ""
            end
        elif op == WebSocketOpCode.Text or op == WebSocketOpCode.Binary
            if ws.frag_opcode >= 0
                _ws_protocol_error(ws, "new message started before fragmented message completed")
                break
            end
            let is_bin = 0
            if op == WebSocketOpCode.Binary
                is_bin = 1
            end
            if frame.fin == true
                let cb = ws.on_message_cb
                if cb is not null
                    cb(ws, frame.payload, is_bin)
                end
            else
                ws.frag_opcode = op
                ws.frag_buffer = frame.payload
            end
        else
            # Process control frame based on OpCode
            when op
                is WebSocketOpCode.Ping then
                    # Automatic RFC 6455 Ping-Pong reply
                    ws_pong(ws, frame.payload)
                    let cb = ws.on_ping_cb
                    if cb is not null
                        cb(ws, frame.payload)
                    end
                is WebSocketOpCode.Pong then
                    let cb = ws.on_pong_cb
                    if cb is not null
                        cb(ws, frame.payload)
                    end
                is WebSocketOpCode.Close then
                    let code = 1000
                    let reason = ""
                    if frame.len >= 2
                        let b0 = ord(char_at(frame.payload, 0))
                        let b1 = ord(char_at(frame.payload, 1))
                        code = bit_or(bit_shl(b0, 8), b1)
                        if frame.len > 2
                            reason = substring(frame.payload, 2, frame.len - 2)
                        end
                    end
                    ws_close(ws, code, reason)
                    break
            end
        end
    end

    return frames_processed
end

## Transmits a binary message with a byte-array payload (NUL-safe).
##
## Uses `write_bytes_fn` when the connection provides one, otherwise falls
## back to `tcp_send_bytes` on the raw socket fd. Event-stream connections
## without a bytes writer cannot send binary frames.
pub function ws_send_bytes(ws: WebSocketConnection, data: array)
    if ws is null or ws.state != WebSocketState.Open
        return false
    end
    let mask = ws.is_server == true ? false : true
    let wire = ws_encode_binary_bytes(data, mask)
    return _ws_raw_write_bytes(ws, wire)
end

function _ws_raw_write_bytes(ws: WebSocketConnection, wire)
    if ws is null or ws.stream is null
        return -1
    end
    if ws.write_bytes_fn is not null
        let w_fn = ws.write_bytes_fn
        return w_fn(ws.stream, wire)
    end
    return net::tcp_send_bytes(ws.stream, wire)
end

## Sends a pong heartbeat frame with a byte-array payload (NUL-safe)
pub function ws_pong_bytes(ws: WebSocketConnection, data = null)
    if ws is null or ws.state != WebSocketState.Open
        return false
    end
    let mask = ws.is_server == true ? false : true
    let wire = ws_frame_encode_bytes(WebSocketOpCode.Pong, data, 1, mask)
    return _ws_raw_write_bytes(ws, wire)
end

## Performs the close handshake over the bytes wire (NUL-safe by construction).
##
## The close reason is omitted: reason strings cannot hold NUL bytes, so an
## arbitrary reason could not round-trip. Code-only closes always encode.
pub function ws_close_bytes(ws: WebSocketConnection, code: int = 1000)
    if ws is null or ws.state == WebSocketState.Closed
        return false
    end
    let mask = ws.is_server == true ? false : true
    let wire = ws_frame_encode_bytes(WebSocketOpCode.Close, [bit_and(bit_shr(code, 8), 255), bit_and(code, 255)], 1, mask)
    _ws_raw_write_bytes(ws, wire)

    ws.state = WebSocketState.Closed
    _ws_raw_close(ws)

    let cb = ws.on_close_cb
    if cb is not null
        cb(ws, code, "")
    end
    return true
end

## Feeds incoming byte-array network data and processes all frames (NUL-safe).
##
## Array counterpart of `ws_feed`: every data callback receives an integer
## array payload, control replies go out over the bytes wire, and protocol
## violations fail with a code-only 1002 close. Do not mix string and bytes
## feeds on one connection (each keeps its own buffer).
pub function ws_feed_bytes(ws: WebSocketConnection, chunk: array)
    if ws is null or chunk is null or len(chunk) == 0
        return false
    end

    let ci = 0
    while ci < len(chunk)
        ws.buffer_bytes.push(chunk[ci])
        ci += 1
    end
    let frames_processed = 0

    while len(ws.buffer_bytes) > 0
        let parsed = ws_frame_parse_bytes(ws.buffer_bytes, 0)
        let frame: WebSocketFrame = parsed[0]
        let consumed = parsed[1]

        if frame is null or consumed == false
            # Buffer contains partial frame, wait for more chunks
            break
        end

        # Advance buffer by consumed bytes
        let rest = []
        let ri = consumed
        while ri < len(ws.buffer_bytes)
            rest.push(ws.buffer_bytes[ri])
            ri += 1
        end
        ws.buffer_bytes = rest

        frames_processed += 1

        let op = frame.opcode

        let violation = _ws_check_frame(ws, frame)
        if violation != ""
            _ws_protocol_error_bytes(ws, violation)
            break
        end

        # ── RFC 6455 §5.4: message fragmentation ──
        if op == WebSocketOpCode.Continuation
            if ws.frag_opcode < 0
                _ws_protocol_error_bytes(ws, "unexpected continuation frame")
                break
            end
            let fi = 0
            while fi < len(frame.payload)
                ws.frag_buf_bytes.push(frame.payload[fi])
                fi += 1
            end
            if frame.fin == true
                let fcb = ws.on_message_cb
                if fcb is not null
                    let fis_bin = 0
                    if ws.frag_opcode == WebSocketOpCode.Binary
                        fis_bin = 1
                    end
                    fcb(ws, ws.frag_buf_bytes, fis_bin)
                end
                ws.frag_opcode = -1
                ws.frag_buf_bytes = []
            end
        elif op == WebSocketOpCode.Text or op == WebSocketOpCode.Binary
            if ws.frag_opcode >= 0
                _ws_protocol_error_bytes(ws, "new message started before fragmented message completed")
                break
            end
            let is_bin = 0
            if op == WebSocketOpCode.Binary
                is_bin = 1
            end
            if frame.fin == true
                let cb = ws.on_message_cb
                if cb is not null
                    cb(ws, frame.payload, is_bin)
                end
            else
                ws.frag_opcode = op
                ws.frag_buf_bytes = frame.payload
            end
        else
            # Process control frame based on OpCode
            when op
                is WebSocketOpCode.Ping then
                    # Automatic RFC 6455 Ping-Pong reply
                    ws_pong_bytes(ws, frame.payload)
                    let cb = ws.on_ping_cb
                    if cb is not null
                        cb(ws, frame.payload)
                    end
                is WebSocketOpCode.Pong then
                    let cb = ws.on_pong_cb
                    if cb is not null
                        cb(ws, frame.payload)
                    end
                is WebSocketOpCode.Close then
                    let code = 1000
                    if frame.len >= 2
                        code = bit_or(bit_shl(frame.payload[0], 8), frame.payload[1])
                    end
                    ws_close_bytes(ws, code)
                    break
            end
        end
    end

    return frames_processed
end

# ═══════════════════════════════════════════════════════════════
# Event Registration & Struct Methods
# ═══════════════════════════════════════════════════════════════

## Registers a text/binary message callback on a connection.
pub function ws_on_message(ws: WebSocketConnection, callback)
    if ws is not null
        ws.on_message_cb = callback
    end
    return ws
end

## Registers a close callback on a connection.
pub function ws_on_close(ws: WebSocketConnection, callback)
    if ws is not null
        ws.on_close_cb = callback
    end
    return ws
end

## Registers a ping callback on a connection.
pub function ws_on_ping(ws: WebSocketConnection, callback)
    if ws is not null
        ws.on_ping_cb = callback
    end
    return ws
end

## Registers a pong callback on a connection.
pub function ws_on_pong(ws: WebSocketConnection, callback)
    if ws is not null
        ws.on_pong_cb = callback
    end
    return ws
end

## Registers an error callback on a connection.
pub function ws_on_error(ws: WebSocketConnection, callback)
    if ws is not null
        ws.on_error_cb = callback
    end
    return ws
end

## Sends a text frame on this connection.
pub function WebSocketConnection.send(self: WebSocketConnection, text: string)
    return ws_send(self, text)
end

## Sends a binary frame on this connection.
pub function WebSocketConnection.send_binary(self: WebSocketConnection, data)
    return ws_send_binary(self, data)
end

## Sends a binary frame with a byte-array payload on this connection.
pub function WebSocketConnection.send_bytes(self: WebSocketConnection, data: array)
    return ws_send_bytes(self, data)
end

## Sends a ping frame on this connection.
pub function WebSocketConnection.ping(self: WebSocketConnection, data: string = "")
    return ws_ping(self, data)
end

## Sends a pong frame on this connection.
pub function WebSocketConnection.pong(self: WebSocketConnection, data: string = "")
    return ws_pong(self, data)
end

## Closes this connection with a status code.
pub function WebSocketConnection.close(self: WebSocketConnection, code: int = 1000, reason: string = "")
    return ws_close(self, code, reason)
end

## Feeds received bytes into this connection.
pub function WebSocketConnection.feed(self: WebSocketConnection, chunk)
    return ws_feed(self, chunk)
end

## Feeds received byte-array data into this connection.
pub function WebSocketConnection.feed_bytes(self: WebSocketConnection, chunk: array)
    return ws_feed_bytes(self, chunk)
end

## Registers a message callback on this connection.
pub function WebSocketConnection.on_message(self: WebSocketConnection, callback)
    return ws_on_message(self, callback)
end

## Registers a close callback on this connection.
pub function WebSocketConnection.on_close(self: WebSocketConnection, callback)
    return ws_on_close(self, callback)
end

## Registers a ping callback on this connection.
pub function WebSocketConnection.on_ping(self: WebSocketConnection, callback)
    return ws_on_ping(self, callback)
end

## Registers a pong callback on this connection.
pub function WebSocketConnection.on_pong(self: WebSocketConnection, callback)
    return ws_on_pong(self, callback)
end

## Registers an error callback on this connection.
pub function WebSocketConnection.on_error(self: WebSocketConnection, callback)
    return ws_on_error(self, callback)
end
