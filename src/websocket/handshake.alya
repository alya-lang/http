# RFC 6455 WebSocket Handshake & Cryptographic Key Resolution
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/str"
import "crypto" as crypto
import "../types.alya"
import "../core/headers.alya"

# RFC 6455 Magic GUID constant
pub const WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

# ═══════════════════════════════════════════════════════════════
# Public WebSocket Handshake API
# ═══════════════════════════════════════════════════════════════

# Computes the RFC 6455 Sec-WebSocket-Accept token from the client key
pub function ws_accept_key(sec_key)
    if sec_key is null or len(sec_key) == 0
        return ""
    end
    let full = sec_key + WS_GUID
    let full_bytes = []
    let i = 0
    let flen = len(full)
    while i < flen
        full_bytes.push(ord(char_at(full, i)))
        i += 1
    end
    let sha1_digest = crypto::sha1_bytes(full_bytes)
    return base64_encode_bytes(sha1_digest)
end

# Determines whether the given HttpRequest is a valid WebSocket upgrade request
pub function ws_is_upgrade_request(req)
    if req is null or req.headers is null
        return 0
    end
    let upgrade = header_get(req.headers, "Upgrade")
    if upgrade is null or lower(upgrade) != "websocket"
        return 0
    end
    let conn = header_get(req.headers, "Connection")
    if conn is null or index_of(lower(conn), "upgrade") < 0
        return 0
    end
    let sec_key = header_get(req.headers, "Sec-WebSocket-Key")
    if sec_key is null or len(sec_key) == 0
        return 0
    end
    return 1
end

# Builds the HTTP 101 Switching Protocols handshake wire response
pub function ws_handshake_response(req, subprotocol = "")
    let sec_key = header_get(req.headers, "Sec-WebSocket-Key")
    let accept_key = ws_accept_key(sec_key)

    let wire = "HTTP/1.1 101 Switching Protocols\r\n"
    wire = wire + "Upgrade: websocket\r\n"
    wire = wire + "Connection: Upgrade\r\n"
    wire = wire + "Sec-WebSocket-Accept: " + accept_key + "\r\n"

    if subprotocol != "" and len(subprotocol) > 0
        wire = wire + "Sec-WebSocket-Protocol: " + subprotocol + "\r\n"
    end

    wire = wire + "\r\n"
    return wire
end
