# HTTP Cookie Parsing and Formatting
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "crypto" as crypto

## Signs a cookie value with HMAC-SHA256, returning `value.signature`
## (base64url). The signature alphabet contains no `.`, so values are
## split on the last dot when verifying.
pub function cookie_sign(value: string, secret: string) -> string
    if value is null
        value = ""
    end
    let sig = crypto::base64url_encode_bytes(crypto::hmac_sha256_bytes(crypto::str_to_bytes(secret), crypto::str_to_bytes(value)))
    return value + "." + sig
end

## Verifies a signed cookie value, returning the original value or `""`
## when the signature is missing, malformed, or forged (constant-time
## comparison; never throws).
pub function cookie_unsign(signed_value: string, secret: string) -> string
    if signed_value is null or signed_value == ""
        return ""
    end
    let dot = -1
    let i = 0
    while i < len(signed_value)
        if substring(signed_value, i, 1) == "."
            dot = i
        end
        i += 1
    end
    if dot < 0
        return ""
    end
    let value = substring(signed_value, 0, dot)
    let sig = substring(signed_value, dot + 1, len(signed_value) - (dot + 1))
    if sig == ""
        return ""
    end
    let expected = crypto::base64url_encode_bytes(crypto::hmac_sha256_bytes(crypto::str_to_bytes(secret), crypto::str_to_bytes(value)))
    if crypto::constant_time_eq(sig, expected) == false
        return ""
    end
    return value
end

## Creates a new HttpCookie struct
pub function cookie_new(name: string, value: string, path: string = "/", max_age: int = -1, http_only: int = 0, secure: int = 0, same_site: string = "Lax")
    return cookie_create(name, value, path, max_age, http_only, secure, same_site)
end

## Formats an HttpCookie struct into a valid Set-Cookie header value
pub function cookie_format(c: HttpCookie) -> string
    if c is null
        return ""
    end
    let res = c.name + "=" + c.value

    if c.path is not null and c.path != ""
        res += "; Path=" + c.path
    end

    if c.domain is not null and c.domain != ""
        res += "; Domain=" + c.domain
    end

    if c.max_age is not null and c.max_age >= 0
        res += "; Max-Age=" + str(c.max_age)
    end

    if c.expires is not null and c.expires != ""
        res += "; Expires=" + c.expires
    end

    if c.http_only == true
        res += "; HttpOnly"
    end

    if c.secure == true
        res += "; Secure"
    end

    if c.same_site is not null and c.same_site != ""
        res += "; SameSite=" + c.same_site
    end

    return res
end

## Internal helper to find substring
pub function _cookie_find(s, target, start_idx: int = 0)
    let slen = len(s)
    let tlen = len(target)
    if tlen == 0
        return start_idx
    end
    let i = start_idx
    while i + tlen <= slen
        if substring(s, i, tlen) == target
            return i
        end
        i += 1
    end
    return -1
end

## Parses incoming 'Cookie' header into a Map of name -> value
pub function cookie_parse(raw)
    if raw is null or len(raw) == 0
        return {}
    end

    let out = {}
    let pairs = split(raw, ";")
    let i = 0
    while i < len(pairs)
        let item = trim(pairs[i])
        if len(item) > 0
            let eq = _cookie_find(item, "=", 0)
            if eq > 0
                let cname = trim(substring(item, 0, eq))
                let cval = trim(substring(item, eq + 1, len(item) - (eq + 1)))
                if len(cval) >= 2 and substring(cval, 0, 1) == "\"" and substring(cval, len(cval) - 1, 1) == "\""
                    cval = substring(cval, 1, len(cval) - 2)
                end
                out[cname] = cval
            end
        end
        i += 1
    end
    return out
end
