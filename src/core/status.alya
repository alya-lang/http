## HTTP Status Codes & Status Introspection.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

## Standard HTTP status codes as an enumeration.
pub enum HttpStatus
    Continue = 100
    SwitchingProtocols = 101

    Ok = 200
    Created = 201
    Accepted = 202
    NonAuthoritativeInfo = 203
    NoContent = 204
    ResetContent = 205
    PartialContent = 206

    MultipleChoices = 300
    MovedPermanently = 301
    Found = 302
    SeeOther = 303
    NotModified = 304
    UseProxy = 305
    TemporaryRedirect = 307
    PermanentRedirect = 308

    BadRequest = 400
    Unauthorized = 401
    PaymentRequired = 402
    Forbidden = 403
    NotFound = 404
    MethodNotAllowed = 405
    NotAcceptable = 406
    ProxyAuthRequired = 407
    RequestTimeout = 408
    Conflict = 409
    Gone = 410
    LengthRequired = 411
    PreconditionFailed = 412
    PayloadTooLarge = 413
    UriTooLong = 414
    UnsupportedMediaType = 415
    RangeNotSatisfiable = 416
    ExpectationFailed = 417
    ImATeapot = 418
    UnprocessableEntity = 422
    TooManyRequests = 429

    InternalServerError = 500
    NotImplemented = 501
    BadGateway = 502
    ServiceUnavailable = 503
    GatewayTimeout = 504
    HttpVersionNotSupported = 505
end

## 1xx Informational status codes
pub const STATUS_CONTINUE = 100
pub const STATUS_SWITCHING_PROTOCOLS = 101

## 2xx Success status codes
pub const STATUS_OK = 200
pub const STATUS_CREATED = 201
pub const STATUS_ACCEPTED = 202
pub const STATUS_NON_AUTHORITATIVE_INFO = 203
pub const STATUS_NO_CONTENT = 204
pub const STATUS_RESET_CONTENT = 205
pub const STATUS_PARTIAL_CONTENT = 206

## 3xx Redirection status codes
pub const STATUS_MULTIPLE_CHOICES = 300
pub const STATUS_MOVED_PERMANENTLY = 301
pub const STATUS_FOUND = 302
pub const STATUS_SEE_OTHER = 303
pub const STATUS_NOT_MODIFIED = 304
pub const STATUS_USE_PROXY = 305
pub const STATUS_TEMPORARY_REDIRECT = 307
pub const STATUS_PERMANENT_REDIRECT = 308

## 4xx Client Error status codes
pub const STATUS_BAD_REQUEST = 400
pub const STATUS_UNAUTHORIZED = 401
pub const STATUS_PAYMENT_REQUIRED = 402
pub const STATUS_FORBIDDEN = 403
pub const STATUS_NOT_FOUND = 404
pub const STATUS_METHOD_NOT_ALLOWED = 405
pub const STATUS_NOT_ACCEPTABLE = 406
pub const STATUS_PROXY_AUTH_REQUIRED = 407
pub const STATUS_REQUEST_TIMEOUT = 408
pub const STATUS_CONFLICT = 409
pub const STATUS_GONE = 410
pub const STATUS_LENGTH_REQUIRED = 411
pub const STATUS_PRECONDITION_FAILED = 412
pub const STATUS_PAYLOAD_TOO_LARGE = 413
pub const STATUS_URI_TOO_LONG = 414
pub const STATUS_UNSUPPORTED_MEDIA_TYPE = 415
pub const STATUS_RANGE_NOT_SATISFIABLE = 416
pub const STATUS_EXPECTATION_FAILED = 417
pub const STATUS_IM_A_TEAPOT = 418
pub const STATUS_UNPROCESSABLE_ENTITY = 422
pub const STATUS_TOO_MANY_REQUESTS = 429

## 5xx Server Error status codes
pub const STATUS_INTERNAL_SERVER_ERROR = 500
pub const STATUS_NOT_IMPLEMENTED = 501
pub const STATUS_BAD_GATEWAY = 502
pub const STATUS_SERVICE_UNAVAILABLE = 503
pub const STATUS_GATEWAY_TIMEOUT = 504
pub const STATUS_HTTP_VERSION_NOT_SUPPORTED = 505

## Returns HTTP 200 OK status code.
pub function status_ok() return 200 end
## Returns HTTP 201 Created status code.
pub function status_created() return 201 end
## Returns HTTP 202 Accepted status code.
pub function status_accepted() return 202 end
## Returns HTTP 204 NoContent status code.
pub function status_no_content() return 204 end
## Returns HTTP 301 Moved Permanently status code.
pub function status_moved_permanently() return 301 end
## Returns HTTP 302 Found status code.
pub function status_found() return 302 end
## Returns HTTP 304 Not Modified status code.
pub function status_not_modified() return 304 end
## Returns HTTP 307 Temporary Redirect status code.
pub function status_temporary_redirect() return 307 end
## Returns HTTP 308 Permanent Redirect status code.
pub function status_permanent_redirect() return 308 end
## Returns HTTP 400 Bad Request status code.
pub function status_bad_request() return 400 end
## Returns HTTP 401 Unauthorized status code.
pub function status_unauthorized() return 401 end
## Returns HTTP 403 Forbidden status code.
pub function status_forbidden() return 403 end
## Returns HTTP 404 Not Found status code.
pub function status_not_found() return 404 end
## Returns HTTP 405 Method Not Allowed status code.
pub function status_method_not_allowed() return 405 end
## Returns HTTP 409 Conflict status code.
pub function status_conflict() return 409 end
## Returns HTTP 429 Too Many Requests status code.
pub function status_too_many_requests() return 429 end
## Returns HTTP 500 Internal Server Error status code.
pub function status_internal_server_error() return 500 end
## Returns HTTP 501 Not Implemented status code.
pub function status_not_implemented() return 501 end
## Returns HTTP 502 Bad Gateway status code.
pub function status_bad_gateway() return 502 end
## Returns HTTP 503 Service Unavailable status code.
pub function status_service_unavailable() return 503 end
## Returns HTTP 504 Gateway Timeout status code.
pub function status_gateway_timeout() return 504 end

## Returns standard HTTP status text for a given status code.
pub function http_status_text(code)
    when code
        is 100 then return "Continue"
        is 101 then return "Switching Protocols"
        is 200 then return "OK"
        is 201 then return "Created"
        is 202 then return "Accepted"
        is 203 then return "Non-Authoritative Information"
        is 204 then return "No Content"
        is 205 then return "Reset Content"
        is 206 then return "Partial Content"
        is 300 then return "Multiple Choices"
        is 301 then return "Moved Permanently"
        is 302 then return "Found"
        is 303 then return "See Other"
        is 304 then return "Not Modified"
        is 305 then return "Use Proxy"
        is 307 then return "Temporary Redirect"
        is 308 then return "Permanent Redirect"
        is 400 then return "Bad Request"
        is 401 then return "Unauthorized"
        is 402 then return "Payment Required"
        is 403 then return "Forbidden"
        is 404 then return "Not Found"
        is 405 then return "Method Not Allowed"
        is 406 then return "Not Acceptable"
        is 407 then return "Proxy Authentication Required"
        is 408 then return "Request Timeout"
        is 409 then return "Conflict"
        is 410 then return "Gone"
        is 411 then return "Length Required"
        is 412 then return "Precondition Failed"
        is 413 then return "Payload Too Large"
        is 414 then return "URI Too Long"
        is 415 then return "Unsupported Media Type"
        is 416 then return "Range Not Satisfiable"
        is 417 then return "Expectation Failed"
        is 418 then return "I'm a teapot"
        is 422 then return "Unprocessable Entity"
        is 429 then return "Too Many Requests"
        is 500 then return "Internal Server Error"
        is 501 then return "Not Implemented"
        is 502 then return "Bad Gateway"
        is 503 then return "Service Unavailable"
        is 504 then return "Gateway Timeout"
        is 505 then return "HTTP Version Not Supported"
        else return "Unknown Status"
    end
end

## Checks if status code is informational (1xx).
pub function http_is_informational(code)
    return code >= 100 and code < 200
end

## Checks if status code is successful (2xx).
pub function http_is_success(code)
    return code >= 200 and code < 300
end

## Checks if status code is redirection (3xx).
pub function http_is_redirect(code)
    return code >= 300 and code < 400
end

## Checks if status code is client error (4xx).
pub function http_is_client_error(code)
    return code >= 400 and code < 500
end

## Checks if status code is server error (5xx).
pub function http_is_server_error(code)
    return code >= 500 and code < 600
end

## Checks if status code represents an error (4xx, 5xx, or negative).
pub function http_is_error(code)
    return code >= 400 or code < 0
end
