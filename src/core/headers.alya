# HTTP Headers Manipulation and Normalization
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Capitalizes an individual word or segment (e.g. "content" -> "Content")
function _cap_word(word)
    if word == null or len(word) == 0
        return ""
    end
    let first = upper(substring(word, 0, 1))
    if len(word) > 1
        let rest = lower(substring(word, 1, len(word) - 1))
        return first + rest
    end
    return first
end

# Converts a header key to canonical Title-Case (e.g. "content-type" -> "Content-Type")
function header_canonical(key)
    if key == null or len(key) == 0
        return ""
    end
    let k = lower(trim(key))
    if k == "etag"
        return "ETag"
    end
    if k == "www-authenticate"
        return "WWW-Authenticate"
    end
    if k == "dnt"
        return "DNT"
    end

    let parts = split(k, "-")
    let res = ""
    let i = 0
    while i < len(parts)
        if i > 0
            res = res + "-"
        end
        res = res + _cap_word(parts[i])
        i += 1
    end
    return res
end

# Gets header value by case-insensitive key. Returns default_val if missing.
function header_get(headers, key, default_val = "")
    if headers == null or key == null
        return default_val
    end
    let k = lower(trim(key))
    if has(headers, k)
        return headers[k]
    end
    let keys = headers.keys()
    let i = 0
    while i < len(keys)
        let cur = keys[i]
        if lower(trim(cur)) == k
            return headers[cur]
        end
        i += 1
    end
    return default_val
end

# Sets header value by case-insensitive key.
function header_set(headers, key, val)
    if headers == null or key == null
        return null
    end
    let k = lower(trim(key))
    headers[k] = val
    return headers
end

# Checks whether a header key exists (case-insensitive).
function header_has(headers, key)
    if headers == null or key == null
        return 0
    end
    let k = lower(trim(key))
    if has(headers, k)
        return 1
    end
    let keys = headers.keys()
    let i = 0
    while i < len(keys)
        let cur = keys[i]
        if lower(trim(cur)) == k
            return 1
        end
        i += 1
    end
    return 0
end

# Returns a new header map with the specified key removed.
function header_remove(headers, key)
    if headers == null
        return {}
    end
    let target = lower(trim(key))
    let out = {}
    let keys = headers.keys()
    let i = 0
    while i < len(keys)
        let k = keys[i]
        if lower(trim(k)) != target
            out[k] = headers[k]
        end
        i += 1
    end
    return out
end

# Serializes headers map to HTTP/1.1 wire format with CRLF endings.
function headers_format(headers)
    if headers == null
        return ""
    end
    let out = ""
    let keys = headers.keys()
    let i = 0
    while i < len(keys)
        let k = keys[i]
        let val = headers[k]
        if val != null
            out = out + header_canonical(k) + ": " + str(val) + "\r\n"
        end
        i += 1
    end
    return out
end
