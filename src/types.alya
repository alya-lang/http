# Types and data structures for alya-lang/http
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Represents an incoming or outgoing HTTP Cookie
pub struct HttpCookie
    name
    value
    path
    domain
    max_age
    expires
    secure
    http_only
    same_site
end

# Represents an HTTP request
pub struct HttpRequest
    method
    url
    path
    query
    query_params
    headers
    body
    params
    cookies
    remote_addr
end

# Represents an HTTP response
pub struct HttpResponse
    status_code
    status_text
    headers
    body
    cookies
end

# Represents a route match result from Router
pub struct RouteMatch
    found
    action
    route
    params
    status
    allowed_methods
end

# Represents the request/response lifecycle context
pub struct HttpContext
    req: HttpRequest
    res: HttpResponse
    client_sock
    aborted
    data
end

# Represents an HTTP Route definition
pub struct HttpRoute
    method
    action
    pattern
    segments
end

# Represents the HTTP Router
pub struct HttpRouter
    routes
    not_found_action
end

# Represents the HTTP Server instance
pub struct HttpServer
    port
    host
    server_sock
    running
    router
    options
    loop
    tcp_server
end

# Represents the HTTP Client configuration
pub struct HttpClient
    timeout_ms
    headers
    follow_redirects
    max_redirects
end

# Factory for HttpCookie
pub function cookie_create(name, value, path = "/", max_age = -1, http_only = 0, secure = 0, same_site = "Lax")
    return HttpCookie {
        name: name,
        value: value,
        path: path,
        domain: "",
        max_age: max_age,
        expires: "",
        secure: secure,
        http_only: http_only,
        same_site: same_site
    }
end

# Factory for HttpRequest
pub function request_create(method, path, query = "", headers = null, body = "", remote_addr = "", params = null, cookies = null, query_params = null)
    if headers is null
        headers = {}
    end
    if params is null
        params = {}
    end
    if cookies is null
        cookies = {}
    end
    if query_params is null
        query_params = {}
    end
    let full_url = path
    if query != ""
        full_url = full_url + "?" + query
    end
    return HttpRequest {
        method: method,
        url: full_url,
        path: path,
        query: query,
        query_params: query_params,
        headers: headers,
        body: body,
        params: params,
        cookies: cookies,
        remote_addr: remote_addr
    }
end

# Factory for HttpResponse
pub function response_create(status_code = 200, status_text = "OK", headers = null, body = "")
    if headers is null
        headers = {}
    end
    return HttpResponse {
        status_code: status_code,
        status_text: status_text,
        headers: headers,
        body: body,
        cookies: []
    }
end

# Factory for HttpContext
pub function context_create(req, res = null, client_sock = -1)
    if res is null
        res = response_create(200, "OK")
    end
    return HttpContext {
        req: req,
        res: res,
        client_sock: client_sock,
        aborted: 0,
        data: {}
    }
end
