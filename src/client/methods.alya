# Top-Level HTTP Client Convenience Functions
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./client.alya"
import "../core/headers.alya"

# Default shared client instance
pub function _default_client()
    return client_new(10000, 1, 5)
end

# Performs an HTTP request with arbitrary method
pub function http_request(method, url_str, headers = null, body = "")
    let client = _default_client()
    return client_execute(client, method, url_str, headers, body)
end

# Convenience GET request
pub function http_get(url_str, headers = null)
    return http_request("GET", url_str, headers, "")
end

# Convenience POST request
pub function http_post(url_str, body = "", content_type = "application/json", headers = null)
    if headers is null
        headers = {}
    end
    if content_type is not null and content_type != ""
        header_set(headers, "Content-Type", content_type)
    end
    return http_request("POST", url_str, headers, body)
end

# Convenience PUT request
pub function http_put(url_str, body = "", content_type = "application/json", headers = null)
    if headers is null
        headers = {}
    end
    if content_type is not null and content_type != ""
        header_set(headers, "Content-Type", content_type)
    end
    return http_request("PUT", url_str, headers, body)
end

# Convenience PATCH request
pub function http_patch(url_str, body = "", content_type = "application/json", headers = null)
    if headers is null
        headers = {}
    end
    if content_type is not null and content_type != ""
        header_set(headers, "Content-Type", content_type)
    end
    return http_request("PATCH", url_str, headers, body)
end

# Convenience DELETE request
pub function http_delete(url_str, headers = null)
    return http_request("DELETE", url_str, headers, "")
end

# Convenience HEAD request
pub function http_head(url_str, headers = null)
    return http_request("HEAD", url_str, headers, "")
end

# Convenience OPTIONS request
pub function http_options(url_str, headers = null)
    return http_request("OPTIONS", url_str, headers, "")
end

# Convenience QUERY request (IETF safe method with payload body)
pub function http_query(url_str, body = "", content_type = "application/json", headers = null)
    if headers is null
        headers = {}
    end
    if content_type is not null and content_type != ""
        header_set(headers, "Content-Type", content_type)
    end
    return http_request("QUERY", url_str, headers, body)
end

# Generates standard HTTP Basic Authentication header string
pub function basic_auth(username, password)
    return "Basic " + base64_encode(username + ":" + password)
end
