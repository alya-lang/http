## Production-ready HTTP Client, Server, Router, and Middleware for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./types.alya"
import "./core/status.alya"
import "./core/headers.alya"
import "./core/cookies.alya"
import "./core/protocol.alya"
import "./router/route.alya"
import "./router/router.alya"
import "./router/group.alya"
import "./middleware/cors.alya"
import "./middleware/logger.alya"
import "./middleware/recovery.alya"
import "./middleware/static.alya"
import "./middleware/compress.alya"
import "./core/compression.alya"
import "./server/context.alya"
import "./server/server.alya"
import "./client/client.alya"
import "./client/methods.alya"
import "./websocket/handshake.alya"
import "./websocket/frame.alya"
import "./websocket/connection.alya"
import "./server/reactive.alya"

# ═══════════════════════════════════════════════════════════════
# High-Level Idiomatic HTTP API
# ═══════════════════════════════════════════════════════════════

## Creates an HTTP server on port and host.
pub function server(port = 8080, host = "0.0.0.0", router_inst = null)
    return server_new(port, host, router_inst)
end

## Creates a new HTTP router.
pub function router(not_found_action = "not_found")
    return router_new(not_found_action)
end

## Creates a new route definition.
pub function route(method, pattern, action)
    return route_new(method, pattern, action)
end

## Creates a new route group with a common path prefix.
pub function group(router_inst, prefix)
    return group_new(router_inst, prefix)
end

## Creates a new HTTP client.
pub function client(timeout_ms = 10000, follow_redirects = 1, max_redirects = 5)
    return client_new(timeout_ms, follow_redirects, max_redirects)
end

## Creates a new HttpRequest struct instance.
pub function request(method, path, query = "", headers = null, body = "", remote_addr = "", params = null, cookies = null, query_params = null)
    return request_create(method, path, query, headers, body, remote_addr, params, cookies, query_params)
end

## Creates a new HttpResponse struct instance.
pub function response(status_code = 200, status_text = "OK", headers = null, body = "")
    return response_create(status_code, status_text, headers, body)
end

## Creates a new HttpContext struct instance.
pub function context(req, res = null, client_sock = -1)
    return context_create(req, res, client_sock)
end

## Creates a new HttpContext instance with helper bindings.
pub function ctx(req, res = null, client_sock = -1)
    return ctx_new(req, res, client_sock)
end

## Creates a new HTTP cookie.
pub function cookie(name, value, path = "/", max_age = -1, http_only = 0, secure = 0, same_site = "Lax")
    return cookie_new(name, value, path, max_age, http_only, secure, same_site)
end

## Creates a new CORS config.
pub function cors(origin = "*", methods = "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH, QUERY", headers = "Content-Type, Authorization, X-Requested-With")
    return cors_config_new(origin, methods, headers)
end

## Creates a new Compression config.
pub function compression(min_length = 256)
    return compression_config_new(min_length)
end

## Compresses payload string with given algorithm ("gzip", "br", "deflate", "zstd").
pub function compress(data_str, encoding = "gzip")
    return http_compress(data_str, encoding)
end

## Decompresses byte list with given algorithm into string.
pub function decompress(bytes_list, encoding = "gzip")
    return http_decompress(bytes_list, encoding)
end

## Returns the standard HTTP status reason phrase for a given code.
pub function status_text(code)
    return http_status_text(code)
end

## Checks if status code is informational (1xx).
pub function is_informational(code)
    return http_is_informational(code)
end

## Checks if status code is successful (2xx).
pub function is_success(code)
    return http_is_success(code)
end

## Checks if status code is redirection (3xx).
pub function is_redirect(code)
    return http_is_redirect(code)
end

## Checks if status code is client error (4xx).
pub function is_client_error(code)
    return http_is_client_error(code)
end

## Checks if status code is server error (5xx).
pub function is_server_error(code)
    return http_is_server_error(code)
end

## Checks if status code represents an error (4xx, 5xx, or negative).
pub function is_error(code)
    return http_is_error(code)
end

## Parses a raw HTTP wire request string into an HttpRequest struct.
pub function parse_request(raw_http, remote_addr = "")
    return http_parse_request(raw_http, remote_addr)
end

## Formats an HttpResponse struct into a raw HTTP wire response string.
pub function format_response(res)
    return http_format_response(res)
end

## Parses a raw HTTP wire response string into an HttpResponse struct.
pub function parse_response(raw_http)
    return http_parse_response(raw_http)
end

## Formats an HttpRequest struct into a raw HTTP wire request string.
pub function format_request(req)
    return http_format_request(req)
end

## Applies error recovery middleware to an HttpContext.
pub function recovery(ctx, err_message = "Internal Server Error")
    return mw_apply_recovery(ctx, err_message)
end

## Serves a static file for an HttpContext from a local directory.
pub function serve_static(ctx, url_prefix, local_dir)
    return mw_serve_static(ctx, url_prefix, local_dir)
end

## Formats a structured log line for an HTTP request.
pub function format_log(method, path, status, latency_ms = -1, remote_addr = "")
    return mw_format_log(method, path, status, latency_ms, remote_addr)
end

## Logs an HttpContext request and response.
pub function log_context(ctx, latency_ms = -1)
    return mw_log_context(ctx, latency_ms)
end

## Splits a URL path into non-empty segments.
pub function split_path(path)
    return route_split_path(path)
end

## Creates and binds an event-driven reactive HTTP/WebSocket server to an EventLoop.
pub function reactive_server(loop, port = 8080, host = "0.0.0.0", router_inst = null, on_request = null, on_websocket = null)
    let s = server_new(port, host, router_inst)
    return server_use_event_loop(s, loop, on_request, on_websocket)
end

## Creates a WebSocket connection wrapper over an event::TcpStream.
pub function websocket(stream, is_server = 1)
    return ws_connection_from_stream(stream, is_server)
end

## Computes the RFC 6455 Sec-WebSocket-Accept token.
pub function ws_accept(sec_key)
    return ws_accept_key(sec_key)
end

## Checks if an incoming request is a WebSocket upgrade request.
pub function ws_is_upgrade(req)
    return ws_is_upgrade_request(req)
end

## Creates a new WebSocket frame struct.
pub function ws_frame(opcode, payload = "", is_final = 1, masked = 0, mask_key = null)
    return ws_frame_create(opcode, payload, is_final, masked, mask_key)
end

## Encodes a WebSocket frame into raw RFC 6455 wire bytes.
pub function ws_encode_frame(opcode, payload, is_client = 0)
    return ws_frame_encode(opcode, payload, is_client)
end

## Creates a low-level WebSocket connection.
pub function ws_conn(stream, is_server = 1, write_fn = null, close_fn = null)
    return ws_connection_new(stream, is_server, write_fn, close_fn)
end
