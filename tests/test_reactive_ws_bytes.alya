## Test Reactive Binary WebSocket Client against a raw-socket stub server
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
import "std/test"
import "std/net" as net
import "event" as ev
import "../src/lib.alya" as http

struct WsBytesState
    opened: int
    received: array
    got_bin: int
    closed: int
    error_msg: string
end

let g_ws_bytes = WsBytesState {
    opened: 0,
    received: [],
    got_bin: 0,
    closed: 0,
    error_msg: ""
}

let g_bin_payload = [72, 101, 0, 108, 108, 111, 0, 255, 1, 254]

function on_wsb_open(ws)
    g_ws_bytes.opened = 1
    http::ws_send_bytes(ws, g_bin_payload)
end

function on_wsb_msg(_ws, msg, is_bin)
    g_ws_bytes.got_bin = is_bin
    g_ws_bytes.received = msg
end

function on_wsb_err(err)
    g_ws_bytes.error_msg = err
end

function on_wsb_close(_ws, _code, _reason)
    g_ws_bytes.closed = 1
end

function tick_loop(l, ticks)
    let t = 0
    while t < ticks
        let events = ev::loop_tick(l, 50)
        for e in events
            ev::loop_dispatch_event(e)
        end
        t += 1
    end
end

function stub_recv_line_text(sock)
    let buf = ""
    let guard = 0
    while guard < 200
        let chunk = net::tcp_recv(sock, 4096)
        if chunk is null or len(chunk) == 0
            break
        end
        buf += chunk
        if index_of(buf, "\r\n\r\n") >= 0
            break
        end
        guard += 1
    end
    return buf
end

function stub_ws_key(headers_text) -> string
    let lines = split(headers_text, "\n")
    let i = 0
    while i < len(lines)
        let line = lower(trim(lines[i]))
        if index_of(line, "sec-websocket-key:") == 0
            return trim(substring(lines[i], len("Sec-WebSocket-Key:"), len(lines[i]) - len("Sec-WebSocket-Key:")))
        end
        i += 1
    end
    return ""
end

function stub_recv_frame(sock)
    let raw = []
    let guard = 0
    while guard < 200
        let chunk = net::tcp_recv_bytes(sock, 4096)
        if chunk is not null and len(chunk) > 0
            let k = 0
            while k < len(chunk)
                raw.push(chunk[k])
                k += 1
            end
        end
        let parsed = http::ws_frame_parse_bytes(raw, 0)
        if parsed[0] is not null
            return parsed[0]
        end
        if chunk is null or len(chunk) == 0
            break
        end
        guard += 1
    end
    return null
end

@cfg(feature = "event")
function main()
    test_suite("Reactive Binary WebSocket Client Tests")
    let r = runner_new()

    let l = ev::loop()
    let port = 19890
    let host = "127.0.0.1"

    # Stub server: raw loopback socket speaking server-side WebSocket bytes.
    let srv = net::tcp_listen(port, 5)
    runner_assert(r, srv >= 0, "stub server listening")
    if srv < 0
        runner_summary(r)
        return
    end

    http::reactive_ws_connect_bytes(l, "ws://" + host + ":" + str(port) + "/wsbin", on_wsb_open, on_wsb_msg, on_wsb_err, on_wsb_close)
    tick_loop(l, 30)

    let peer = net::tcp_accept(srv)
    runner_assert(r, peer >= 0, "stub accepted client")
    if peer < 0
        net::tcp_close(srv)
        runner_summary(r)
        return
    end
    net::tcp_set_timeout(peer, 5000)

    let handshake = stub_recv_line_text(peer)
    let key = stub_ws_key(handshake)
    runner_assert(r, len(key) > 0, "stub got client handshake key")
    let accept_wire = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + http::ws_accept(key) + "\r\n\r\n"
    net::tcp_send(peer, accept_wire)
    tick_loop(l, 30)

    runner_assert_eq(r, g_ws_bytes.opened, 1, "binary client opened and sent payload")
    runner_assert_str_eq(r, g_ws_bytes.error_msg, "", "no client error")

    let frame = stub_recv_frame(peer)
    runner_assert(r, frame is not null, "stub got client binary frame")
    runner_assert_eq(r, frame.opcode, 2, "client frame is binary")
    runner_assert_eq(r, frame.masked, 1, "client frame is masked")

    let echo_wire = http::ws_encode_binary_bytes(frame.payload, 0)
    net::tcp_send_bytes(peer, echo_wire)
    tick_loop(l, 30)

    runner_assert_eq(r, g_ws_bytes.got_bin, 1, "echo arrived as binary")
    runner_assert_eq(r, len(g_ws_bytes.received), len(g_bin_payload), "echo length matches")
    let bi = 0
    let same = 1
    while bi < len(g_bin_payload)
        if g_ws_bytes.received[bi] != g_bin_payload[bi]
            same = 0
        end
        bi += 1
    end
    runner_assert_eq(r, same, 1, "echo bytes match upload exactly (NUL intact)")

    net::tcp_close(peer)
    net::tcp_close(srv)

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

@cfg(not(feature = "event"))
function main()
    test_suite("Reactive Binary WebSocket Client Tests (skipped without event feature)")
    let r = runner_new()
    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
