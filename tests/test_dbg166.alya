## TEMPORARY diagnostic for alya-lang/alya#166 (REMOVE after diagnosis).
## Isolates tcp_poll (select): no client connects, so poll must time
## out and return false. If THIS faults, fn_net_poll/select is guilty.
import "std/test"
import "std/net" as net
import "../src/lib.alya" as http

function main()
    test_suite("dbg166")
    let r = runner_new()

    let srv3 = http::server_new(19999, "127.0.0.1", null)
    http::server_start(srv3)
    runner_assert_true(r, true, "DBG166 poll-started")
    let ready = net::tcp_poll(srv3.server_sock, 2000)
    runner_assert(r, ready != true, "DBG166 poll-times-out")
    http::server_close(srv3)
    runner_assert_true(r, true, "DBG166 poll-done")

    let failed = runner_summary(r)
    if failed > 0
        say f"Test failure: {failed} test(s) failed."
    end
end

main()
