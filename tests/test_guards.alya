## Test suite for rate limiting and request ID middleware
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
import "std/test"
import "../src/lib.alya" as http

function main()
    test_suite("HTTP Guards Middleware Tests")
    let r = runner_new()

    # 1. Limiter allows up to the limit, then denies
    let lim = http::rate_limit_new(2, 60000)
    runner_assert_eq(r, http::rate_limit_check(lim, "c1"), 1, "hit 1 allowed")
    runner_assert_eq(r, http::rate_limit_check(lim, "c1"), 1, "hit 2 allowed")
    runner_assert_eq(r, http::rate_limit_check(lim, "c1"), 0, "hit 3 denied")
    # Buckets are per-key
    runner_assert_eq(r, http::rate_limit_check(lim, "c2"), 1, "other key allowed")

    # 2. Window reset reopens the bucket (no sleeping: rewind the clock)
    lim.start_ms = clock_ms() - 120000
    runner_assert_eq(r, http::rate_limit_check(lim, "c1"), 1, "post-window hit allowed")

    # 3. Middleware denies with 429 + Retry-After
    let lim2 = http::rate_limit_new(1, 60000)
    let ctx_ok = http::ctx_new(http::request_create("GET", "/api"))
    runner_assert_eq(r, http::mw_apply_rate_limit(ctx_ok, lim2, "k"), 1, "first hit passes")
    let ctx_denied = http::ctx_new(http::request_create("GET", "/api"))
    runner_assert_eq(r, http::mw_apply_rate_limit(ctx_denied, lim2, "k"), 0, "second hit denied")
    runner_assert_eq(r, ctx_denied.res.status_code, 429, "deny status 429")
    runner_assert_eq(r, ctx_denied.aborted, 1, "deny aborts")
    runner_assert(r, http::header_get(ctx_denied.res.headers, "Retry-After") != "", "retry-after set")

    # 4. Server-level rate limiting keyed by remote address
    let rt = http::router()
    http::router_get(rt, "/api", "api_index")
    let s = http::server_new(9878, "127.0.0.1", rt)
    http::server_enable_rate_limit(s, 1, 60000)
    let first = http::ctx_new(http::request_create("GET", "/api"))
    let m1 = http::server_process(s, first)
    runner_assert_eq(r, m1.found, 1, "first request passes")
    let second = http::ctx_new(http::request_create("GET", "/api"))
    let m2 = http::server_process(s, second)
    runner_assert_eq(r, m2.status, 429, "second request throttled")

    # 5. Request IDs echo incoming values and generate otherwise
    let echo_req = http::request_create("GET", "/t")
    http::header_set(echo_req.headers, "X-Request-ID", "trace-1")
    let echo_ctx = http::ctx_new(echo_req)
    runner_assert_str_eq(r, http::mw_request_id(echo_ctx), "trace-1", "incoming id echoed")
    runner_assert_str_eq(r, http::header_get(echo_ctx.res.headers, "X-Request-ID"), "trace-1", "echo mirrored to response")
    let gen_ctx = http::ctx_new(http::request_create("GET", "/t"))
    let gen_id = http::mw_request_id(gen_ctx)
    runner_assert(r, len(gen_id) > 4 and substring(gen_id, 0, 4) == "req-", "generated id format")
    let gen_ctx2 = http::ctx_new(http::request_create("GET", "/t"))
    let gen_id2 = http::mw_request_id(gen_ctx2)
    runner_assert(r, gen_id2 != gen_id, "generated ids unique")

    # 6. Server-level request IDs tag every response
    let s2 = http::server_new(9879, "127.0.0.1", rt)
    http::server_enable_request_id(s2, 1)
    let tagged = http::ctx_new(http::request_create("GET", "/api"))
    http::server_process(s2, tagged)
    runner_assert(r, http::header_get(tagged.res.headers, "X-Request-ID") != "", "server tags response")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
