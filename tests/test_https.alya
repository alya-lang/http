## Test suite for native HTTPS client (tls, no curl)
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
import "std/test"
import "../src/lib.alya" as http

function main()
    test_suite("HTTPS Client Tests")
    let r = runner_new()

    # 1. Client TLS policy defaults and setter
    let c = http::client()
    runner_assert_eq(r, c.tls_verify, 1, "tls verification on by default")
    http::client_set_tls_verify(c, 0)
    runner_assert_eq(r, c.tls_verify, 0, "tls verification disabled")
    http::client_set_tls_verify(c, 7)
    runner_assert_eq(r, c.tls_verify, 1, "tls verify normalizes to 0/1")

    # 2. Unreachable endpoint fails closed without throwing
    let bad = http::client_new(2000, 0, 0, 1)
    let res = http::https_execute(bad, "GET", "https://127.0.0.1:1/", null, "")
    runner_assert_eq(r, res.status_code, -1, "refused https reports -1")
    runner_assert_true(r, len(res.status_text) > 0, "refused https message set")

    # 3. Invalid URL rejected
    let bad_url = http::https_execute(bad, "GET", "https://", null, "")
    runner_assert_eq(r, bad_url.status_code, -1, "empty host rejected")

    # 4. Bytes response parser with text body
    let text_raw = [72, 84, 84, 80, 47, 49, 46, 49, 32, 50, 48, 48, 32, 79, 75, 13, 10, 67, 111, 110, 116, 101, 110, 116, 45, 76, 101, 110, 103, 116, 104, 58, 32, 50, 13, 10, 13, 10, 72, 105]
    let text_res = http::http_parse_response_bytes(text_raw)
    runner_assert_eq(r, text_res.status_code, 200, "bytes parse status")
    runner_assert_str_eq(r, text_res.body, "Hi", "bytes parse text body")
    runner_assert_eq(r, len(text_res.body_bytes), 2, "bytes parse body bytes")

    # 5. Bytes response parser with NUL binary body
    let bin_raw = [72, 84, 84, 80, 47, 49, 46, 49, 32, 50, 48, 48, 32, 79, 75, 13, 10, 13, 10, 1, 0, 2, 0, 3]
    let bin_res = http::http_parse_response_bytes(bin_raw)
    runner_assert_eq(r, bin_res.status_code, 200, "binary parse status")
    runner_assert_str_eq(r, bin_res.body, "", "binary body text empty")
    runner_assert_eq(r, len(bin_res.body_bytes), 5, "binary body bytes kept")
    runner_assert_eq(r, bin_res.body_bytes[1], 0, "NUL byte preserved")

    # 6. Body accessors
    runner_assert_eq(r, len(http::response_body_bytes(bin_res)), 5, "body bytes accessor")
    runner_assert_str_eq(r, http::response_body_text(bin_res), "", "binary text accessor empty")
    runner_assert_str_eq(r, http::response_body_text(text_res), "Hi", "text accessor")
    runner_assert_eq(r, len(http::response_body_bytes(null)), 0, "null response safe")

    # 7. Byte helpers
    runner_assert_eq(r, http::proto_find_bytes([1, 2, 3, 4], [3, 4], 0), 2, "byte find hit")
    runner_assert_eq(r, http::proto_find_bytes([1, 2], [9], 0), -1, "byte find miss")
    runner_assert_eq(r, http::bytes_are_text([65, 66]), 1, "text bytes")
    runner_assert_eq(r, http::bytes_are_text([65, 0]), 0, "nul bytes not text")

    # 8. Request wire builder
    let wire = http::https_build_request("GET", "example.com", "/a?b=1", {}, "")
    runner_assert_str_eq(r, substring(wire, 0, 19), "GET /a?b=1 HTTP/1.1", "request line")
    runner_assert_true(r, len(wire) > 60, "wire carries headers")
    let post_wire = http::https_build_request("POST", "example.com", "/", {}, "hi")
    runner_assert_true(r, len(post_wire) > len(wire), "post body extends wire")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
