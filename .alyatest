# Alya Test/Bench Discovery Configuration (.alyatest)
# Official configuration schema for packages under the alya-lang ecosystem.
# Documentation: https://github.com/alya-lang/alya

[test]
# Paths, directories, or patterns to exclude from `alya test` discovery:
# exclude = ["slow"]
# test_reactive_sse is parked until alya-lang/alya#131 is fixed: any binary
# mixing SseEvent construction with the event loop cannot pass on 0.0.20.
exclude = ["tests/test_reactive_sse.alya"]

[bench]
# Paths, directories, or patterns to exclude from `alya bench` discovery:
# exclude = ["heavy"]
exclude = []
